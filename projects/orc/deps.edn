{:paths []
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; LMDB-NATIVE-HARNESS-CRASH: pin lmdbjava ahead of grain's transitive
        ;; 0.9.2. Not a proven fix for the SIGSEGV (no matching changelog
        ;; entry), but free and can't hurt — see workspace.edn's "orc"
        ;; project entry and docs/build-timeline/issues/lmdb-native-harness-crash/.
        org.lmdbjava/lmdbjava {:mvn/version "0.9.3"}

        obneyai/grain-core-v2 {:git/url "https://github.com/ObneyAI/grain.git"
                               :git/sha "8236c80f14a582539cd15ae5426d1da16b5e1839"
                               :deps/root "projects/grain-core-v2"}

        orc/llm               {:local/root "../../components/llm"}
        orc/orc-service       {:local/root "../../components/orc-service"}
        orc/gepa              {:local/root "../../components/gepa"}
        orc/evaluation        {:local/root "../../components/evaluation"}
        orc/colbert           {:local/root "../../components/colbert"}
        orc/ontology          {:local/root "../../components/ontology"}
        orc/mcp-sheet-builder {:local/root "../../components/mcp-sheet-builder"}
        orc/langfuse          {:local/root "../../components/langfuse"}
        orc/file-store        {:local/root "../../components/file-store"}
        orc/file-store-local  {:local/root "../../components/file-store-local"}
        orc/file-store-s3     {:local/root "../../components/file-store-s3"}

        ;; LLM Providers
        litellm/bedrock       {:git/url "https://github.com/ObneyAI/litellm-clj.git"
                               :git/sha "130ea352f7d45abe1896d2854b4df41becaa9309"
                               :deps/root "contrib/bedrock"}}

 :aliases {:test {:extra-paths []
                  :extra-deps {orc/grain-test-utils {:local/root "../../components/grain-test-utils"}
                               ;; orc-service owns cross-component E2E tests for
                               ;; these tool bricks. Keep them test-only while
                               ;; making every Poly project that contains the
                               ;; orc-service brick able to load its test suite.
                               orc/predict-rlm-pdf {:local/root "../../components/predict-rlm-pdf"}
                               orc/predict-rlm-redaction-tools {:local/root "../../components/predict-rlm-redaction-tools"}
                               orc/predict-rlm-invoice-tools {:local/root "../../components/predict-rlm-invoice-tools"}
                               obneyai/grain-control-plane {:git/url "https://github.com/ObneyAI/grain.git"
                                                           :git/sha "8236c80f14a582539cd15ae5426d1da16b5e1839"
                                                           :deps/root "projects/grain-control-plane"}}}}}
