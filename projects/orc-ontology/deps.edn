{:paths []
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; Keep the ontology-only project on the same recovered Grain graph as
        ;; the aggregate ORC projects while those upstream changes are pending.
        ;; Mixing this graph with Grain's gitlib-owned schema-util produces two
        ;; unrelated local roots and prevents the test basis from resolving.
        cat/schema-util {:local/root "/Users/darylroberts/Desktop/Code/grain-rr-durable-pin/components/schema-util"}

        obneyai/grain-core-v2 {:local/root "/Users/darylroberts/Desktop/Code/grain-rr-durable-pin/projects/grain-core-v2"}

        ;; The ontology / general-memory stack — explicitly self-describing:
        ;;   ontology    → event-sourced concept graph + DJL embeddings +
        ;;                 evolutionary builder + self-improving write-side
        ;;   orc-service → the engine its discovery/builder sheets run on
        ;;   langfuse    → orc-service's tracing layer
        ;; NO colbert, NO Python. Retrieval runs on graph BFS + DJL embeddings.
        ;; ColBERT (Layer 5) is resolved lazily — add the orc-colbert package
        ;; to light up the third retrieval signal.
        orc/llm         {:local/root "../../components/llm"}
        orc/ontology    {:local/root "../../components/ontology"}
        orc/orc-service {:local/root "../../components/orc-service"}
        orc/file-store  {:local/root "../../components/file-store"}
        orc/langfuse    {:local/root "../../components/langfuse"}}

 :aliases {:test {:extra-paths []
                  :extra-deps {}}}}
