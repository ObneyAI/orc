{:paths []
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; LMDB-NATIVE-HARNESS-CRASH: pin lmdbjava ahead of grain's transitive
        ;; 0.9.2. See workspace.edn's "orc"/"orc-colbert" project entries and
        ;; docs/build-timeline/issues/lmdb-native-harness-crash/.
        org.lmdbjava/lmdbjava {:mvn/version "0.9.3"}

        obneyai/grain-core-v2 {:git/url "https://github.com/ObneyAI/grain.git"
                               :git/sha "47073a2820f571b31fe784311886613a9ed3297e"
                               :deps/root "projects/grain-core-v2"}

        ;; The pure-JVM ColBERT signal (ADR 0002) — the optional Layer-5
        ;; late-interaction upgrade. A leaf component (its ontology reference is
        ;; resolved lazily). Add this alongside orc-ontology to light up the
        ;; third retrieval signal in hybrid-search. Pulls DJL (api + HuggingFace
        ;; tokenizers + OnnxRuntime engine, 0.31.1) and downloads the
        ;; answerai-colbert-small-v1 encoder checkpoint (~133MB) into a local
        ;; cache on first use — no Python (-Dcolbert.model.path overrides for
        ;; air-gapped machines).
        orc/colbert {:local/root "../../components/colbert"}}

 :aliases {:test {:extra-paths []
                  :extra-deps {}}}}
