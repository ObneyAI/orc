{:paths []
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; Pin schema-util at the same Grain SHA as every other project so the

        ;; core-v2 and event-store-sqlite-v3 gitlibs resolve to one copy (aligned

        ;; with projects/orc-service).

        cat/schema-util {:git/url "https://github.com/ObneyAI/grain.git" :git/sha "ba57602781cf081605bb56bdc3c4eebfe0317579" :deps/root "components/schema-util"}


        obneyai/grain-core-v2 {:git/url "https://github.com/ObneyAI/grain.git"
                               :git/sha "ba57602781cf081605bb56bdc3c4eebfe0317579"
                               :deps/root "projects/grain-core-v2"}

        ;; MCP Sheet Builder (Layer 8) — generates ORC behavior trees from MCP
        ;; tool schemas. Self-describing:
        ;;   mcp-sheet-builder → the generator
        ;;   orc-service       → the engine the generated trees run on
        ;;   langfuse          → orc-service's tracing layer
        ;; NO ontology, NO colbert, NO DJL, NO Python. Standalone capability.
        orc/llm               {:local/root "../../components/llm"}
        orc/mcp-sheet-builder {:local/root "../../components/mcp-sheet-builder"}
        orc/orc-service       {:local/root "../../components/orc-service"}
        orc/file-store        {:local/root "../../components/file-store"}
        orc/langfuse          {:local/root "../../components/langfuse"}}

 :aliases {:test {:extra-paths []
                  :extra-deps {}}}}
