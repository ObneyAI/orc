l fit for raw-input → normalized → enriched → emit-ready flows" "each stage's :reads consume the previous stage's :writes — explicit data dependency tracking"], :strengths [{:trait "explicit per-stage :reads/:writes dependency chain makes ETL debuggable — failures isolate to the stage that produced the broken intermediate", :good-when "input requires multiple distinct transformation passes AND each pass produces a named intermediate (normalized, enriched, formatted)", :recommended-pattern "[:sequence [:llm {:reads [:raw-input] :writes [:normalized]}] [:llm {:reads [:normalized :reference-data] :writes [:enriched]}] [:code {:reads [:enriched] :writes [:emit-ready] :fn (fn [{:keys [enriched]}] {:emit-ready (clojure.string/join \",\" enriched)})}] [:final {:keys [:emit-ready]}]]", :confidence 1.0, :evidence-count 1, :first-observed-at "2026-05-28T00:00:00Z", :last-reinforced-at "2026-05-28T00:00:00Z"} {:trait "use :code (NOT :llm) for the final emit-format stage when the format is deterministic — saves tokens and avoids drift in field names", :good-when "the final stage is mechanical formatting (CSV row assembly, JSON envelope wrapping, fixed-width record padding)", :recommended-pattern "[:code {:reads [:enriched] :writes [:row] :fn (fn [{:keys [enriched]}] {:row (clojure.string/join \",\" (map :v enriched))})}]", :confidence 1.0, :evidence-count 1, :first-observed-at "2026-05-28T00:00:00Z", :last-reinforced-at "2026-05-28T00:00:00Z"}], :avoid-when ["the work is per-chunk independent — use chunked-extraction instead" "stages can run in parallel writing to distinct keys — use :parallel instead" "the chain is 1 stage — just use a single :llm or :code node directly"], :parent-tree-id "seed:tree:SequentialPipeline", :weaknesses [{:trait "ETL chains break when an intermediate stage silently emits a different shape than the next stage expects — typed :output-schemas catch the shape mismatch at the wrong stage", :avoid-when "intermediate stages don't declare :output-schemas a