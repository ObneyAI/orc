;; RS-7 traffic briefs — hand-authored by the orchestrator (2026-09-22). Ground truth for the realistic-traffic
;; convergence experiment: every generated instruction inherits its brief's :group, :in-domain? and
;; :expected-seed-id. The generator never sees :group or :brief-id. Fields: subject matter (what the task is about),
;; material (what is read), output kind (what is produced), instance space (how variants may differ), must-not-be
;; (the neighbouring domain a variant must not drift into). Seed ids: document-analysis
;; 00000000-c1c1-4001-b001-d0c0a0a0a0a1, risk-analysis …b002-…a2, contract-comparison …b003-…a3,
;; legal-issue-detection …b004-…a4.
[;; ---- in-domain (must match the seed; zero mints expected) ----
 {:brief-id "b-001" :group "legal-issue-detection" :in-domain? true
  :expected-seed-id #uuid "00000000-c1c1-4001-b004-d0c0a0a0a0a4"
  :subject-matter "reviewing a contract or agreement for legal concerns" :material "the clause or agreement text, pasted"
  :output-kind "a list of issues, each with severity, area of law, a citation of the offending text and a suggested revision"
  :instance-space "employment, contractor, NDA, SaaS terms, lease, licensing; one clause or a whole short agreement; varied jurisdictions"
  :must-not-be "drafting a new clause from scratch, or comparing two versions"}
 {:brief-id "b-002" :group "contract-comparison" :in-domain? true
  :expected-seed-id #uuid "00000000-c1c1-4001-b003-d0c0a0a0a0a3"
  :subject-matter "comparing two versions or two drafts of a contract" :material "two contract texts or two versions of one"
  :output-kind "an executive summary, a section-by-section diff quoting both texts, an impact analysis and a recommendation"
  :instance-space "SaaS agreements, MSAs, leases, supplier terms, employment offers; version-vs-version or party-vs-party drafts"
  :must-not-be "reviewing one contract alone for issues"}
 {:brief-id "b-003" :group "risk-analysis" :in-domain? true
  :expected-seed-id #uuid "00000000-c1c1-4001-b002-d0c0a0a0a0a2"
  :subject-matter "identifying risks and obligations in a long document" :material "an RFP, contract, regulatory filing or policy, long enough to chunk"
  :output-kind "obligations and penalties extracted per section, a risk matrix rated HIGH/MEDIUM/LOW with justification, and an executive summary"
  :instance-space "public-sector RFPs, vendor contracts, compliance regulations, insurance policies; varied lengths and sectors"
  :must-not-be "a general summary with key dates and entities, or a legal-issue review with revisions"}
 {:brief-id "b-004" :group "document-analysis" :in-domain? true
  :expected-seed-id #uuid "00000000-c1c1-4001-b001-d0c0a0a0a0a1"
  :subject-matter "extracting a summary, key dates and named entities from one large document" :material "a single long document (RFP, report, filing, transcript)"
  :output-kind "a summary, a list of key dates with what happens on each, and the entities (organisations, people, places, amounts)"
  :instance-space "RFPs, annual reports, court filings, meeting transcripts, grant calls; varied length and register"
  :must-not-be "a risk matrix, or an issue review"}
 ;; ---- near-domain confounders (off-domain by construction; report mints under a seed separately) ----
 {:brief-id "b-005" :group "clause-drafting" :in-domain? false :confounder-of #uuid "00000000-c1c1-4001-b004-d0c0a0a0a0a4"
  :subject-matter "drafting a new contract clause to a requirement" :material "a plain-language requirement and the surrounding agreement context"
  :output-kind "the drafted clause text plus a short rationale and negotiation notes"
  :instance-space "non-compete, IP assignment, SLA, limitation of liability, data processing; varied jurisdictions"
  :must-not-be "reviewing an existing clause for issues"}
 {:brief-id "b-006" :group "compliance-checklist" :in-domain? false :confounder-of #uuid "00000000-c1c1-4001-b002-d0c0a0a0a0a2"
  :subject-matter "turning a regulation or standard into an actionable compliance checklist for one organisation" :material "the regulation or standard text and a description of the organisation"
  :output-kind "a checklist of controls with owner, evidence required and due date, grouped by article or section"
  :instance-space "GDPR, SOC 2, HIPAA, PCI DSS, ISO 27001, a national procurement rule; varied organisation sizes"
  :must-not-be "a risk matrix over a contract"}
