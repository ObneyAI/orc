eet/node-execution-started, :sheet-id #uuid "4d782c6b-5574-4298-b5b9-a4aa3cf20a28", :event/id #uuid "019e431d-a1ad-70ef-9251-5413045216fb"}, :mulog/root-trace #mulog/flake "5A3YaiFyH2kiewe6IvQCXfDXP8Uoad4l", :mulog/timestamp 1779242475949, :metric/name "TodoProcessed", :mulog/trace-id #mulog/flake "5A3YaiFyH2kiewe6IvQCXfDXP8Uoad4l", :mulog/event-name :ai.obney.grain.todo-processor-v2.core/processing-event, :metric/resolution :high}
