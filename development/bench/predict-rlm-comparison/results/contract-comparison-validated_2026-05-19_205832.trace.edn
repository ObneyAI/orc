poses of administering the Contract. Supplier shall, where \nrequested by OPA, irrevocably authorize agencies, and third parties to release to OPA any \ninformation or data relating to the Facility which may be required by OPA for the purposes of \nadministering the Contract.   \n3.6 Section 6.6 of Part 2 of the Contract does not apply.  Supplier shall, at the request of OPA, \nprovide OPA with all copies of settlement statements, invoices, records and documents \nrelating to the Facility or any Generation Payment made in respect thereof or pursuant hereto. \n \n \n ", :ai.obney.orc.orc-service.core.todo-processors/map-each-index 4, :ai.obney.orc.orc-service.core.todo-processors/map-each-parent #uuid "73703afb-6940-4721-8949-e096457d70f5"}, :node-id #uuid "0b2d09ee-1294-4a2f-a286-5b098b2f36e8", :event/type :sheet/node-execution-started, :sheet-id #uuid "5241eb9d-a207-4d82-a629-77059bb1f90e", :event/id #uuid "019e431b-803b-70a4-a15e-9045817e0a78"}, :mulog/root-trace #mulog/flake "5A3YTa4ZHvwrERjKrSUyGSv5_xOPaRrs", :mulog/timestamp 1779242336315, :metric/name "TodoProcessed", :mulog/trace-id #mulog/flake "5A3YTa4ZHvwrERjKrSUyGSv5_xOPaRrs", :mulog/event-name :ai.obney.grain.todo-processor-v2.core/processing-event, :metric/resolution :high}
