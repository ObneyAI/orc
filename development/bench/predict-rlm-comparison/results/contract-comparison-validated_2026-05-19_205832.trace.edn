ce and wording."]}}, :node-id #uuid "c02269d5-7d9c-4e42-abe7-4d80a5f08eca", :event/type :sheet/node-execution-started, :sheet-id #uuid "5241eb9d-a207-4d82-a629-77059bb1f90e", :event/id #uuid "019e431c-4f64-709d-873b-92b020118617"}, :mulog/root-trace #mulog/flake "5A3YWfdfzmeghggSZCPs15bRcoM4SGjx", :mulog/timestamp 1779242389348, :metric/name "TodoProcessed", :mulog/trace-id #mulog/flake "5A3YWfdfzmeghggSZCPs15bRcoM4SGjx", :mulog/event-name :ai.obney.grain.todo-processor-v2.core/processing-event, :metric/resolution :high}
