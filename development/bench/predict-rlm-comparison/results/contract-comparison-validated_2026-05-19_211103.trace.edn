ns: \n(a) applicable federal, provincial or municipal laws, orders-in-council, by-laws, codes, rules, policies, \nregulations and statutes; \n(b) applicable orders, decisions, codes, judgments, injunctions, decrees, awards and writs of any \ncourt, tribunal, arbitrator, Governmental Authority or other person having jurisdiction; \n(c) applicable rulings and conditions of any licence, permit, certificate, registration, authorization, \nconsent and approval issued by a Governmental Authority; \n(d) any requirements under or prescribed by applicable common law; and \n(e) the Retail Settlement Code and the Distribut", :ai.obney.orc.orc-service.core.todo-processors/map-each-index 2, :ai.obney.orc.orc-service.core.todo-processors/map-each-parent #uuid "42e7e2ff-fcf2-49db-b8d5-b34d823afcae"}, :node-id #uuid "df853ff0-0550-4452-89c5-310c0d0710ba", :event/type :sheet/node-execution-started, :sheet-id #uuid "b5bd8208-dee2-409f-b862-7761ff30e225", :event/id #uuid "019e4327-005e-70f5-bbc7-2c2f548a1417"}, :mulog/root-trace #mulog/flake "5A3Z9Spinwv95rfKePAfMnUGKlOJSWKz", :mulog/timestamp 1779243090015, :metric/name "TodoProcessed", :mulog/trace-id #mulog/flake "5A3Z9Spinwv95rfKePAfMnUGKlOJSWKz", :mulog/event-name :ai.obney.grain.todo-processor-v2.core/processing-event, :metric/resolution :high}
