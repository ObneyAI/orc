nt/tags #{[:sheet #uuid "b5bd8208-dee2-409f-b862-7761ff30e225"] [:node #uuid "c7972d77-97bf-4dd2-841f-fefd2902b741"] [:tick #uuid "219b2581-94f2-4a59-a930-d4b10b8a2717"]}, :event/timestamp #time/offset-date-time "2026-05-19T21:11:51.541396-05:00", :status :success, :node-id #uuid "c7972d77-97bf-4dd2-841f-fefd2902b741", :event/type :sheet/node-execution-completed, :sheet-id #uuid "b5bd8208-dee2-409f-b862-7761ff30e225", :event/id #uuid "019e4327-5475-7058-a9e5-2f27ee8083f2"}, :mulog/root-trace #mulog/flake "5A3ZAi16Cho37ZGE-cv7tEVbTUtw09Tf", :mulog/timestamp 1779243111542, :metric/name "TodoProcessed", :mulog/trace-id #mulog/flake "5A3ZAi16Cho37ZGE-cv7tEVbTUtw09Tf", :mulog/event-name :ai.obney.grain.todo-processor-v2.core/processing-event, :metric/resolution :high}
{:mulog/duration 9708, :mulog/namespace "ai.obney.grain.todo-processor-v2.core", :mulog/outcome :ok, :mulog/parent-trace nil, :event {:tick-id #uuid "219b2581-94f2-4a59-a930-d4b10b8a2717", :writes {:v3_full_map {:summary ["### **Section Headings and Clauses**\n\n**Part 1 – Contract Details**\n*   **A. CONTRACT AND SUPPLIER INFORMATION**\n    *   (1) Reference Number\n    *   (2) Supplier Name\n    *   (3) Contract Commencement Date\n    *   (4) Contract End Date\n    *   (5) Legal Entity Relationship to LDC (Connection Agreement)\n    *   (6) LDC Generator Account Number\n    *   (7) Contract Price\n    *   (8) Percentage Escalated\n    *   (9) Base Date\n    *   (10) Supplier Contact Information\n    *   (11) Representative Contact Information\n*   **B. FACILITY CHARACTERISTICS**\n    *   (1) LDC Distribution System Connection\n    *   (2) Facility Location (PIN and Address)\n    *   (3) Renewable Fuel type\n    *   (4) Nameplate Capacity (kW)\n    *   (5) Solar PV Specifics (Inverter/Array ratings, Rooftop status)\n    *   (6) Connection type (Directly/Indirectly/In Parallel)\n    *   (7) Battery Back-up compliance\n    *   (8) Wind Capacity specifics\n*   **C. DOCUMENTS INCLUDED; DEFINED TERMS**\n\n**Part 2 – General Terms and Conditions**\n*   **1. TERM**\n*   **2. PRICING PROVISIONS AND PAYMENT**\n    *   2.1. Indexed Contract Price\n    *   2.2. Payment (Generation Payments, Settlement Period)\n*   **3. ENVIRONMENTAL ATTRIBUTES**\n    *   3.1. Transfer\n    *   3.2. Action to Transfer\n    *   3.3. Action to Register (Regulatory Environmental Attributes)\n    *   3.4. Cost Reimbursement\n*   **4. REPRESENTATIONS AND WARRANTIES**\n    *   4.1. Connection\n    *   4.2. Facility Characteristics\n    *   4.3. Metering\n    *   4.4. Necessary Rights and Compliance\n    *   4.5. Supplier Eligibility\n*   **5. COVENANTS**\n    *   5.1. Facility Characteristics\n\n### **Key Legal and Financial Terms**\n*   **LDC (Local Distribution Company):** The entity responsible f