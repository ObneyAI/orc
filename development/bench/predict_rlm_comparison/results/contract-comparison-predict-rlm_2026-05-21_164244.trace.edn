{:mulog/duration 10542, :mulog/namespace "ai.obney.grain.todo-processor-v2.core", :mulog/outcome :ok, :mulog/parent-trace nil, :event {:tick-id #uuid "64dda040-e175-4588-9ba2-826669fbe8e4", :writes {:doc_a_survey {:version "Version 2.0", :title "Feed-In Tariff microFIT Contract", :structure_overview "This contract is divided into two primary parts: Part 1 (Contract Details) and Part 2 (General Terms and Conditions), followed by technical and definitional appendices (A through E).", :sections [{:section_name "Part 1 – Contract Details", :pages "1-3", :summary "Identifies the specific supplier, facility location, contract duration (20 or 40 years), pricing, and technical characteristics like nameplate capacity and fuel type.", :notable_terms ["Contract Price" "Nameplate Capacity" "Renewable Fuel" "Percentage Escalated"]} {:section_name "Part 2 – General Terms and Conditions", :pages "4-10", :summary "Establishes the legal framework for the agreement, including payment settlement via the LDC, transfer of environmental attributes, and comprehensive representations/warranties regarding eligibility.", :notable_terms ["Environmental Attributes" "Generation Payments" "LDC" "Audit Rights" "FIPPA"]} {:section_name "Appendix A – Definitions", :pages "11-14", :summary "Standardized definitions for technical and legal terms used throughout the contract, such as 'Abut', 'Deemed Single Property', and 'Project Eligibility Requirements'.", :notable_terms ["Eligible Participant" "IESO Controlled Grid" "Domestic Content Level"]} {:section_name "Appendix B – Calculation of Indexed Contract Price", :pages "15", :summary "Provides the mathematical formula for adjusting the contract price based on the Consumer Price Index (CPI) if a Percentage Escalated is applicable.", :notable_terms ["CPI" "Indexed Pricing Period"]} {:section_name "Appendix C – Solar PV Schedule", :pages "16-19", :summary "Specifies domestic content requirements (60%) for solar projects and provides grids for calculating the qualifying percentage of Ontario-based activities.", :notable_terms ["Minimum Required Domestic Content Level" "Designated Activities" "Rooftop Facility"]} {:section_name "Appendix D-1 – Directly Connected Facility Schedule", :pages "20", :summary "Contains covenants for facilities connected independently of load, specifically prohibiting battery backup systems.", :notable_terms ["Directly Connected Facility"]} {:section_name "Appendix D-2 – Indirectly Connected Facility Schedule", :pages "21", :summary "Defines 'In Parallel' connections and specifies the acceptable configuration for battery backup systems.", :notable_terms ["In Parallel" "Battery Back-up"]} {:section_name "Appendix E – LDC Supplier Schedule", :pages "22-23", :summary "Amends the contract for instances where the Local Distribution Company (LDC) is also the Supplier, including modified payment settlement through the IESO.", :notable_terms ["IESO Market Rules" "Transmission System Code"]}]}}, :duration-ms 4873, :event/tags #{[:tick #uuid "64dda040-e175-4588-9ba2-826669fbe8e4"] [:node #uuid "e76ec302-9eba-4149-bc55-8b74cf973bf9"] [:sheet #uuid "d0749cdc-3361-47db-ae83-387a69752505"]}, :event/timestamp #time/offset-date-time "2026-05-21T16:43:14.673652-05:00", :usage {:prompt-tokens 13709, :completion-tokens 808, :total-tokens 14517}, :status :success, :node-id #uuid "e76ec302-9eba-4149-bc55-8b74cf973bf9", :event/type :sheet/node-execution-completed, :sheet-id #uuid "d0749cdc-3361-47db-ae83-387a69752505", :event/id #uuid "019e4c7e-1ff1-7006-9b82-0c8b4c77e3e4"}, :mulog/root-trace #mulog/flake "5A5mfsDr9lJjgWHrb056acfsSDp6b5S-", :mulog/timestamp 1779399794687, :metric/name "TodoProcessed", :mulog/trace-id #mulog/flake "5A5mfsDr9lJjgWHrb056acfsSDp6b5S-", :mulog/event-name :ai.obney.grain.todo-processor-v2.core/processing-event, :metric/resolution :high}
