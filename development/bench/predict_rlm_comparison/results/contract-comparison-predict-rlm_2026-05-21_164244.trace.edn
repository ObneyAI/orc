{:mulog/duration 2277208, :mulog/namespace "ai.obney.grain.command-processor-v2.core", :mulog/outcome :ok, :mulog/parent-trace nil, :ai.obney.grain.command-processor-v2.core/command {:tick-id #uuid "64dda040-e175-4588-9ba2-826669fbe8e4", :writes {:doc_b_survey {:version "3.1.1", :title "FEED-IN TARIFF MICROFIT CONTRACT", :structure_overview "The contract consists of two primary parts (Contract Details and General Terms) followed by five appendices (A through E) defining terms, pricing calculations, and technology-specific rules.", :sections [{:section_name "Part 1 – Contract Details", :pages "1-4", :summary "Identifies the Supplier, the Local Distribution Company (LDC), contract dates, and specific technical characteristics of the Facility (Renewable Fuel, Nameplate Capacity, and connection type).", :notable_terms ["Contract Price" "Nameplate Capacity" "Percentage Escalated" "Base Date" "Renewable Fuel"]} {:section_name "Part 2 - General Terms and Conditions", :pages "5-11", :summary "Outlines the legal framework including payment mechanics, transfer of environmental attributes, representations and warranties, information disclosure rights, and termination clauses.", :notable_terms ["Indexed Contract Price" "Environmental Attributes" "Eligible Participant" "Access Rights" "FIPPA" "Joint and Several Liability"]} {:section_name "Appendix A – Definitions", :pages "12-16", :summary "A comprehensive list of defined terms used throughout the contract, clarifying technical, legal, and regulatory terminology.", :notable_terms ["Abut" "Deemed Single Property" "Laws and Regulations" "microFIT Rules" "Project Eligibility Requirements"]} {:section_name "Appendix B – Calculation of Indexed Contract Price", :pages "17", :summary "Provides the mathematical formula for adjusting the Contract Price based on the Consumer Price Index (CPI) and the Percentage Escalated.", :notable_terms ["CPI" "Indexed Pricing Period" "First Price Period"]} {:section_name "Appendix C – Solar Photovoltaic Schedule", :pages "18", :summary "Contains additional definitions specifically for solar energy projects, defining what qualifies as an existing building or rooftop facility.", :notable_terms ["Existing Building" "Rooftop Facility"]} {:section_name "Appendix D-1 – Directly Connected Facility Schedule", :pages "19", :summary "Sets out requirements for facilities connected independently of load, specifically prohibiting battery back-up systems.", :notable_terms ["Directly Connected Facility" "Battery back-up"]} {:section_name "Appendix D-2 – Indirectly Connected Facility Schedule", :pages "20", :summary "Defines 'In Parallel' connections and specifies the permitted configurations for battery back-up systems for indirectly connected facilities.", :notable_terms ["In Parallel" "Permitted Battery Configuration"]} {:section_name "Appendix E – LDC Supplier Schedule", :pages "21-22", :summary "Modifies the contract terms for instances where the Local Distribution Company itself is the Supplier, including adjustments to settlement mechanics and laws.", :notable_terms ["IESO Market Rules" "Transmission System Code" "Permanent Disconnection"]}]}}, :command/name :sheet/complete-node-execution, :command/timestamp #time/offset-date-time "2026-05-21T16:43:14.671862-05:00", :command/id #uuid "efb997cc-595c-401a-8293-6404234fb9f9", :duration-ms 4871, :usage {:prompt-tokens 12052, :completion-tokens 790, :total-tokens 12842}, :status :success, :node-id #uuid "7d7359db-5260-428e-a1e6-d28900fa30d4", :sheet-id #uuid "d0749cdc-3361-47db-ae83-387a69752505"}, :mulog/root-trace #mulog/flake "5A5mfsA9egwLQIso_IDOqPkNsO6y81qK", :mulog/timestamp 1779399794671, :metric/name "CommandProcessed", :mulog/trace-id #mulog/flake "5A5mfsA9egwLQIso_IDOqPkNsO6y81qK", :mulog/event-name :ai.obney.grain.command-processor-v2.core/process-command, :metric/resolution :high}
