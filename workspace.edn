{:top-namespace "ai.obney.orc"
 :interface-ns "interface"
 :default-profile-name "default"
 :compact-views #{}
 :vcs {:name "git"
       :auto-add false}
 :tag-patterns {:stable "^stable-.*"
                :release "^v[0-9].*"}
 :projects {"development" {:alias "dev"}
            ;; Each packaging project validates its primary brick. Transitive
            ;; brick suites run in their own project and in the aggregate `orc`
            ;; project, whose classpath contains every cross-component E2E
            ;; dependency. This prevents a transitive `orc-service` dependency
            ;; from trying to load its cross-component tests on a deliberately
            ;; minimal package classpath.
            "orc-service" {:test {:include ["orc-service"]}}
            "orc-evaluation" {:test {:include ["evaluation"]}}
            "orc-gepa" {:test {:include ["gepa"]}}
            "orc-mcp-sheet-builder" {:test {:include ["mcp-sheet-builder"]}}
            "orc-ontology" {:test {:include ["ontology"]}}
            ;; LMDB-NATIVE-HARNESS-CRASH: colbert's brick tests moved OUT of
            ;; the `orc` project and INTO their own `orc-colbert` project.
            ;;
            ;; `clojure -M:poly test project:orc :all-bricks` (CI's "ORC test
            ;; suites" job) intermittently aborts the whole test JVM with a
            ;; native SIGSEGV in `lmdbjava-native-library-*.so` (2 of ~40 CI
            ;; runs observed; both self-healed on rerun). The crash always
            ;; lands within seconds of `judge-runtime-test` (evaluation
            ;; brick) starting, immediately after colbert's own LMDB-heavy
            ;; suite (index-store-test, corpus-test, index-search-test, ...)
            ;; runs earlier in that SAME JVM/classloader — :all-bricks runs
            ;; every brick's tests once, in one process, by design. Confirmed
            ;; unrelated to any application-side leak (every test context's
            ;; teardown correctly closes its LMDB env) and unrelated to any
            ;; single PR (reproduced on two unrelated diffs). Full dossier:
            ;; docs/build-timeline/issues/lmdb-native-harness-crash/.
            ;;
            ;; Excluding colbert from `orc` and running it under its own
            ;; `orc-colbert` project instead gives it a genuinely separate
            ;; JVM process in CI (a separate `run:` step — see
            ;; .github/workflows/tests.yml), removing the adjacency without
            ;; losing coverage. `orc`'s new :exclude and orc-colbert's new
            ;; :include are mutually exclusive by construction, so colbert's
            ;; tests run in exactly one project's scope under every
            ;; invocation mode (solo `project:X`, or a composite mode that
            ;; touches both projects in one JVM) — never duplicated, and
            ;; never sharing a classloader with `orc`'s suite.
            "orc" {:test {:exclude ["colbert"]}}
            "orc-colbert" {:test {:include ["colbert"]}}}}
