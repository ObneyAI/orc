# Benchmark / live-verify run output — regenerated every run, never committed.
development/bench/generalization-results/

# Large binary test fixtures. Keep these local; share via external storage if needed.
development/resources/

# Pure-JVM ColBERT index artifacts (ADR 0002) — derived data, always
# rebuildable from the events that describe the corpus. Default index root
# (override via -Dcolbert.index.root).
.orc-colbert-indexes/

# Local-only follow-up working notes. Survive compaction (filesystem-tracked)
# but never committed — they're scratch planning that becomes stale fast.
docs/issues/c2d-followups/

# Resumable local state for the Allium convergence loop.
.allium-loop/
