-- allium: 3
-- evaluation.allium
--
-- Scope: post-execution quality evaluation for ORC traces and node completions.
-- Includes: criteria/stance/scale separation, discrete band scoring, typed
-- evidence before verdict, no-run-through validation, four built-in LLM judges,
-- structural and custom judges, weighted aggregation, asynchronous per-node
-- evaluation, idempotent score recording, composite scores, and trace summaries.
-- Judges are behaviours: every judge is an ORC workflow reading a rubric value,
-- attached to any node scope, and each judgment is a durable assessment with
-- its own identity, outcome, purpose and provenance. Per-node-version
-- performance is collected from assessment outcomes.
-- Excludes: model-provider transport mechanics, prompt/tool-schema
-- implementation, Grain processor mechanics, logging, and ORC trace storage.
-- Durable resolved-model and usage provenance are included.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity EvaluationConsumer {}

external entity OrcNode {
    node_type: String
}

-- The ORC execution of a judge behaviour on behalf of one assessment.
external entity JudgeExecution {}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value TraceEvidence {
    sheet_identifier: String
    node_identifier: String
    tick_identifier: String
    instruction: String
    inputs: Any
    outputs: Any
    execution_trace: Any?
    -- The campaign's own ordered immutable iteration records, read straight from
    -- the durable projection rather than waiting on asynchronous trace
    -- publication. Named as the engine names them, so a reader can find them.
    researcher_iterations: List<Any>?
    -- Bounded claim/completion/checkpoint/yield/resume evidence for the campaign,
    -- in DURABLE order. Effect results are deliberately excluded: this is the
    -- account of what the campaign DID, not what its effects returned.
    researcher_events: List<Any>?
    completion_kind: String?
}

value ModelProvenance {
    provider: String?
    model: String
    usage: Any?
}

value DiscreteScale {
    minimum_level: Integer
    maximum_level: Integer
    band_descriptions: Any
}

value BandedJudgeOutput {
    reasoning: String
    positive_evidence: List<String>
    negative_evidence: List<String>
    level: Integer
    feedback: String
}

value MetricDimension {
    name: String
    weight: Decimal
    score: Decimal
    feedback: String
}

value ScoreWithFeedback {
    score: Decimal
    feedback: String
    dimensions: List<MetricDimension>
    model_provenance: ModelProvenance?
}


value JudgeConfiguration {
    definition: Any
}

-- The editable grading contract a judge behaviour reads from its blackboard.
-- Changing it never changes the judge's tree; it produces a new judge revision.
value Rubric {
    criterion: String
    stance: String
    scale: DiscreteScale
    feedback: FeedbackMode
}

-- Native decision-model evidence for a band chosen from a distribution. The
-- selected band is the unique most probable level; the distribution, the
-- provider's expected position and its confidence are kept as returned.
value BandDistribution {
    probabilities: Any
    expected_position: Decimal?
    confidence: Decimal?
}

value Coverage {
    expected: Integer
    scored: Integer
    failed: Integer
    ungradable: Integer
    pending: Integer
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DiscreteBandScoring {
    validate_scale: (scale: DiscreteScale) -> Any
    score_level: (scale: DiscreteScale, level: Integer) -> Decimal
    gate_output: (scale: DiscreteScale, output: BandedJudgeOutput) -> ScoreWithFeedback

    @invariant CompleteBands
        -- Minimum is lower than maximum and every integer level in the closed
        -- range has a non-empty, explicit quality description.

    @invariant DeterministicMapping
        -- A valid level maps to (level - minimum) / (maximum - minimum), yielding
        -- zero at the lowest band and one at the highest.

    @invariant NoRunThrough
        -- Nil, empty, missing-level, non-integral, and out-of-range judge output
        -- is rejected rather than silently converted to a score.

    @invariant ScoreNotSelfReported
        -- The model chooses a discrete level after producing reasoning and
        -- evidence; the continuous score is derived by the evaluator.
}

contract TraceJudge {
    evaluate: (judge: Judge, trace: TraceEvidence) -> ScoreWithFeedback

    @invariant CriteriaStanceScaleSeparation
        -- What a judge evaluates, its adversarial review stance, and its scoring
        -- scale are independent artifacts composed only at evaluation time.

    @invariant ReasonBeforeVerdict
        -- Typed judge output orders reasoning and concrete positive/negative
        -- evidence before the discrete level and actionable feedback.

    @invariant FailureIsolation
        -- A judge failure or timeout does not suppress successful results from
        -- other judges evaluating the same completion.

    @invariant CustomJudgeConfinement
        -- A judge runs as a bounded ORC workflow. Its result is a band on its
        -- rubric's scale, from which the score is derived. Work carried out on
        -- behalf of an assessment is never itself assessed automatically, however
        -- the work is scheduled and across process restarts; judges may still
        -- delegate, run parallel checks and call tools inside their own tree.

    @invariant JudgesSeeTheWorkNotOnlyItsResult
        -- A judge scoring work that was carried out over several iterations
        -- receives an account of those iterations — what was attempted, what
        -- each attempt produced or failed with, and how the work recovered — not
        -- only the final values it wrote. A verdict remains one per completion:
        -- the material a judge reads becomes richer, while what it is asked to
        -- judge stays the whole piece of work. Judging every iteration
        -- separately would let a piece of work that took many attempts outvote
        -- one that took few. Only verdict-bearing campaign completions are
        -- judged; cancelled campaigns retain inspectable evidence but receive
        -- no work-quality verdict.

    @invariant DurableModelProvenance
        -- A successful model-backed score retains the resolved model, trace
        -- identity, and token usage that produced it; provider mechanics remain
        -- outside this contract.

    @invariant JudgesAreBehaviours
        -- Every judge, built-in or custom, is an ORC workflow executed against
        -- the assessment's evidence, so judge model calls are budgeted,
        -- accounted, retried and selectable exactly like any other node's.
        -- Heuristic structural judging is a deterministic judgment that calls no
        -- model.

    @invariant JudgeModelResolvesLikeAnyNode
        -- A judge's model comes from its declaration, else from the runtime's
        -- configured provider, exactly as for any model-backed node. The engine
        -- carries no built-in judge model. A judge whose model cannot be
        -- resolved produces a failed assessment that says how to configure one.

    @invariant EvidenceByScope
        -- By default a judge sees the assessed execution's own resolved reads and
        -- writes, its instruction, and the original task of the run as a
        -- separate item. A judge on a composite, delegate or root may also read
        -- the complete execution family beneath it and the assessments already
        -- made within it. Child assessments are evidence for the parent judge,
        -- never a substitute for its own grade. Evidence is never truncated.
}

contract AssessmentRecording {
    request: (subject: Any, judge: Judge) -> Assessment
    record_outcome: (assessment: Assessment, outcome: Any) -> Assessment

    @invariant AssessmentIdentity
        -- An assessment is identified by the completion it assesses, the judge
        -- and the judge revision. Delivering the same completion again requests
        -- nothing new and performs no judging; distinct executions of one node
        -- in one run are distinct subjects. The assessments requested for a
        -- completion are decided when it is first processed: a judge attached or
        -- revised afterwards assesses later completions, never that one again.

    @invariant NothingInvented
        -- A missing band, an incomplete supporting dimension, blank feedback a
        -- rubric requires, an unresolved model, a provider failure or a missed
        -- deadline is a failed or ungradable outcome with its reason; none of
        -- them becomes a score.

    @invariant FailedSubjectsAreNotGraded
        -- A completion that failed, timed out or is blocked is still requested,
        -- but its assessments are ungradable because the subject failed, with
        -- the subject's failure as the reason; no judge runs. A judge that
        -- declares it assesses failures grades them like any completion. A
        -- partial completion is graded.

    @invariant FeedbackIsOptional
        -- A rubric declares whether feedback is required. A score-only
        -- assessment carries no feedback rather than empty feedback, and no
        -- explanation is ever synthesized for it.

    @invariant ExactTieIsUngradable
        -- When a decision model returns an exact tie for the most probable band,
        -- the assessment is ungradable; the expected position is never rounded
        -- into a band, and the tie is not retried in search of a different one.

    @invariant HistoryIsAdditive
        -- Assessment and score records are never rewritten. Records made before
        -- bands, revisions or node versions were recorded show them as absent.
}

contract PerformanceMonitoring {
    performance: (node: OrcNode, node_version: String?, judge: Judge?) -> Any

    @invariant PerformanceIsAlwaysCollected
        -- Every assessment outcome contributes to the performance of the node
        -- version it assessed, per judge and judge revision, with coverage
        -- beside every grade. Subject failures are counted apart and never
        -- enter a quality statistic.

    @invariant NodeVersionsDoNotBlend
        -- A node version is the node's effective definition when it executed;
        -- performance of different versions is reported separately and can be
        -- compared.

    @invariant ThresholdWatchingIsOptIn
        -- Only a declared alert watches a trailing window. A crossing is
        -- signalled once and re-arms on recovery; a window whose coverage is too
        -- low signals degraded coverage instead of poor performance, and its
        -- recovery is signalled once too. A window speaks only once it is full;
        -- its coverage counts every outcome in it and its mean only the scored
        -- ones, and too little coverage is signalled before any crossing.
        -- A signal never starts training by itself.
}

contract EvaluationAttachmentResolver {
    effective_judges: (node: OrcNode, completion_kind: String?, living_description_enabled: Boolean) -> List<Judge>

    @invariant ExplicitAttachmentWins
        -- An explicit node attachment, including an empty attachment, overrides
        -- all defaults.

    @invariant OptInDefaults
        -- With no explicit attachment, the five default judges apply only to
        -- repl-researcher nodes when Living Descriptions are enabled.

    @invariant AttachmentIsMonitoring
        -- An explicitly attached judge always assesses the completions of the
        -- node it is attached to, whether or not Living Descriptions are
        -- enabled. Any node may carry judges: leaves, researchers, composites,
        -- delegates and the root.

    @invariant PublishedRunsAreJudgedAsTheirSourceNode
        -- A run of a published workflow version is judged by the attachments of
        -- the draft node each of its nodes was published from, so attaching a
        -- judge monitors every version's runs; its assessments and performance
        -- belong to that source node, separated by node version.

    @invariant CompletionKindFiltering
        -- A judge declaring completion kinds runs only for matching non-null
        -- kinds; judges without such a filter apply to every completion.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum JudgeType {
    grounding | instruction_following | reasoning | completeness |
    heuristic_structural | custom
}

enum FeedbackMode {
    required | none
}

-- What a judge's results are for. Monitoring results describe performance;
-- learning results also feed the loops that learn from judge feedback, and so
-- must carry feedback.
enum JudgePurpose {
    monitoring | learning
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Judge {
    name: String
    judge_type: JudgeType
    criteria: String
    adversarial_stance: String
    scale: DiscreteScale?
    weight: Decimal?
    configuration: JudgeConfiguration
    applicable_completion_kinds: Set<String>?
    rubric: Rubric?
    purposes: Set<JudgePurpose>
    revision: String
}

entity Assessment {
    subject_completion: String
    judge: Judge
    judge_revision: String
    node_version: String?
    -- Assessments whose outcomes this one reads as evidence; fixed when the
    -- assessment is requested.
    depends_on: Set<Assessment>
    status: pending | scored | failed | ungradable
    band: Integer? when status = scored
    score: Decimal when status = scored
    feedback: String? when status = scored
    band_distribution: BandDistribution?
    reason: String when status = failed | ungradable
    model_provenance: ModelProvenance?
    late: Boolean

    transitions status {
        pending -> scored
        pending -> failed
        pending -> ungradable
        terminal: scored, failed, ungradable
    }
}

entity JudgeScore {
    -- The assessment a score belongs to; absent on scores recorded before
    -- assessments existed and on the legacy tree-shape path.
    assessment: Assessment?
    sheet_identifier: String
    node_identifier: String
    tick_identifier: String
    judge: Judge
    score: Decimal
    feedback: String
    dimensions: List<MetricDimension>
    model_provenance: ModelProvenance?
    emitted_at: Timestamp
}

entity CompositeScore {
    -- The completion a composite summarises; absent on legacy composites.
    subject_completion: String?
    sheet_identifier: String
    node_identifier: String
    tick_identifier: String
    score: Decimal
    contributing_scores: Set<JudgeScore>
    coverage: Coverage?
    partial: Boolean
    emitted_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RequestAssessment {
    when: SubjectCompleted(subject_completion, judge, node_version, depends_on, under_assessment)
    requires: not under_assessment
    requires: not exists Assessment{
        subject_completion: subject_completion,
        judge: judge,
        judge_revision: judge.revision
    }

    ensures: Assessment.created(
        subject_completion: subject_completion,
        judge: judge,
        judge_revision: judge.revision,
        node_version: node_version,
        depends_on: depends_on,
        status: pending,
        late: false
    )
}

rule StartAssessment {
    when: assessment: Assessment.created
    requires: assessment.depends_on.all(d => d.status != pending)

    ensures: AssessmentJudgingStarted(assessment: assessment)
}

rule StartWaitingAssessment {
    when: dependency: Assessment.status transitions_to scored | failed | ungradable
    for waiting in Assessments where status = pending:
        requires: dependency in waiting.depends_on
        requires: waiting.depends_on.all(d => d.status != pending)
        ensures: AssessmentJudgingStarted(assessment: waiting)
}

rule RecordScoredAssessment {
    when: AssessmentGraded(assessment, band, score, feedback, band_distribution, model_provenance)
    requires: assessment.status = pending
    requires: score >= 0
    requires: score <= 1
    requires: assessment.judge.rubric = null
        or assessment.judge.rubric.feedback = none
        or feedback != null

    ensures: assessment.status = scored
    ensures: assessment.band = band
    ensures: assessment.score = score
    ensures: assessment.feedback = feedback
    ensures: assessment.band_distribution = band_distribution
    ensures: assessment.model_provenance = model_provenance
}

rule RecordFailedAssessment {
    when: AssessmentFailed(assessment, reason, model_provenance)
    requires: assessment.status = pending

    ensures: assessment.status = failed
    ensures: assessment.reason = reason
    ensures: assessment.model_provenance = model_provenance
}

rule RecordUngradableAssessment {
    when: AssessmentUngradable(assessment, reason, band_distribution, model_provenance)
    requires: assessment.status = pending

    ensures: assessment.status = ungradable
    ensures: assessment.reason = reason
    ensures: assessment.band_distribution = band_distribution
    ensures: assessment.model_provenance = model_provenance
}

rule RecordLateResult {
    when: AssessmentResultArrivedLate(assessment)
    requires: assessment.status = failed

    ensures: assessment.late = true
}

rule ReviseJudge {
    when: JudgeRevised(judge, rubric, configuration, revision)
    requires: revision != judge.revision

    ensures: judge.rubric = rubric
    ensures: judge.configuration = configuration
    ensures: judge.revision = revision
}

rule SignalPerformanceThreshold {
    when: PerformanceWindowEvaluated(node, node_version, judge, trailing_score, coverage_ratio, alert, previously_crossed)
    requires: alert != null
    requires: not previously_crossed
    requires: coverage_ratio >= alert.min_coverage
    requires: trailing_score < alert.below

    ensures: PerformanceThresholdCrossed(node: node, node_version: node_version, judge: judge, trailing_score: trailing_score)
}

rule EvaluateCompletedNode {
    when: NodeCompletionAvailable(trace, effective_judges)
    requires: effective_judges.count > 0

    ensures:
        for judge in effective_judges:
            JudgeEvaluationRequested(judge: judge, trace: trace)
}

rule RecordSuccessfulJudgeEvaluation {
    when: JudgeEvaluationSucceeded(judge, trace, result)
    -- The score record read by the learning loops comes only from judges whose
    -- purpose includes learning, and only for a scored assessment.
    requires: learning in judge.purposes
    requires: result.score >= 0
    requires: result.score <= 1
    requires: not exists JudgeScore{
        sheet_identifier: trace.sheet_identifier,
        node_identifier: trace.node_identifier,
        tick_identifier: trace.tick_identifier,
        judge: judge
    }

    ensures: JudgeScore.created(
        sheet_identifier: trace.sheet_identifier,
        node_identifier: trace.node_identifier,
        tick_identifier: trace.tick_identifier,
        judge: judge,
        score: result.score,
        feedback: result.feedback,
        dimensions: result.dimensions,
        model_provenance: result.model_provenance,
        emitted_at: now
    )
    ensures: CompositeEvaluationRequested(
        sheet_identifier: trace.sheet_identifier,
        node_identifier: trace.node_identifier,
        tick_identifier: trace.tick_identifier
    )
}

rule RecordCompositeEvaluation {
    when: CompositeEvaluationRequested(sheet_identifier, node_identifier, tick_identifier)
    let scores = JudgeScores where
        sheet_identifier = sheet_identifier
        and node_identifier = node_identifier
        and tick_identifier = tick_identifier
    requires: scores.count >= 2
    requires: not exists CompositeScore{
        sheet_identifier: sheet_identifier,
        node_identifier: node_identifier,
        tick_identifier: tick_identifier
    }

    ensures: CompositeScore.created(
        sheet_identifier: sheet_identifier,
        node_identifier: node_identifier,
        tick_identifier: tick_identifier,
        score: normalized_weighted_score(scores),
        contributing_scores: scores,
        emitted_at: now
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant JudgeScoresAreBounded {
    for result in JudgeScores:
        result.score >= 0 and result.score <= 1
}

invariant CompositeScoresAreBounded {
    for result in CompositeScores:
        result.score >= 0 and result.score <= 1
}

invariant OneAssessmentPerIdentity {
    for a in Assessments:
        for b in Assessments:
            a != b implies not (
                a.subject_completion = b.subject_completion
                and a.judge = b.judge
                and a.judge_revision = b.judge_revision
            )
}

invariant ScoredAssessmentsAreBounded {
    for a in Assessments:
        a.status = scored implies (a.score >= 0 and a.score <= 1)
}

invariant LearningJudgesRequireFeedback {
    for j in Judges:
        (learning in j.purposes and j.rubric != null) implies j.rubric.feedback = required
}

invariant OneJudgeScorePerAssessment {
    for a in JudgeScores:
        for b in JudgeScores:
            a != b implies not (a.assessment != null and a.assessment = b.assessment)
}

invariant OneJudgeScorePerCompletion {
    for a in JudgeScores:
        for b in JudgeScores:
            a != b implies not (
                a.assessment = null and b.assessment = null
                and a.sheet_identifier = b.sheet_identifier
                and a.node_identifier = b.node_identifier
                and a.tick_identifier = b.tick_identifier
                and a.judge = b.judge
            )
}

invariant OneCompositePerSubject {
    for a in CompositeScores:
        for b in CompositeScores:
            a != b implies not (a.subject_completion != null
                                and a.subject_completion = b.subject_completion)
}

invariant OneCompositePerCompletion {
    for a in CompositeScores:
        for b in CompositeScores:
            a != b implies not (
                a.subject_completion = null and b.subject_completion = null
                and a.sheet_identifier = b.sheet_identifier
                and a.node_identifier = b.node_identifier
                and a.tick_identifier = b.tick_identifier
            )
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface EvaluationAccess {
    facing consumer: EvaluationConsumer

    exposes:
        Judge
        JudgeScore
        CompositeScore
        Assessment

    provides:
        JudgeRevised(judge, rubric, configuration, revision)

    contracts:
        fulfils DiscreteBandScoring
        fulfils TraceJudge
        fulfils EvaluationAttachmentResolver
        fulfils AssessmentRecording
        fulfils PerformanceMonitoring

    @guarantee NonBlockingCompletionProcessing
        -- Node completion processing schedules judge work without waiting for
        -- model latency; results are recorded asynchronously through idempotent
        -- score commands.

    @guarantee ActionableFeedback
        -- Every successful score from a learning judge carries written feedback
        -- suitable for human diagnosis and downstream instruction optimization. Score-only monitoring results never reach the learning
        -- loops.

    @guarantee HonestComposite
        -- A composite is formed once per subject, over its learning judges, after
        -- every one of their assessments has settled, when at least two were
        -- expected. It carries coverage and is marked partial when any judge did
        -- not score; when none scored it carries coverage and no score. It never
        -- mixes monitoring-only and learning results.

    @guarantee PayForWhatYouUse
        -- Execution-family evidence, waits on child assessments, composites,
        -- learning records and threshold watching do no work unless a judge or
        -- attachment declares that it needs them.
}

-- Completions of attached nodes, delivered by ORC execution, are what
-- assessments are requested for; performance windows are re-evaluated as
-- outcomes arrive.
surface NodeCompletionFeed {
    facing node: OrcNode

    provides:
        SubjectCompleted(subject_completion, judge, node_version, depends_on, under_assessment)
        NodeCompletionAvailable(trace, effective_judges)
        PerformanceWindowEvaluated(node, node_version, judge, trailing_score, coverage_ratio, alert, previously_crossed)
}

-- A judge behaviour's execution reports how its assessment ended.
surface AssessmentExecution {
    facing execution: JudgeExecution

    provides:
        AssessmentGraded(assessment, band, score, feedback, band_distribution, model_provenance)
        AssessmentFailed(assessment, reason, model_provenance)
        AssessmentUngradable(assessment, reason, band_distribution, model_provenance)
        AssessmentResultArrivedLate(assessment)
        JudgeEvaluationSucceeded(judge, trace, result)
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Assessment work currently runs as soon as it is requested, without a limit on how many run at once, and work in progress when a process stops stays pending. How many assessments may run concurrently, how is pending work claimed and recovered after a restart, and how are a judge body that outlives its deadline and in-flight work at shutdown stopped or drained?"

