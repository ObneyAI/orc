-- allium: 3
-- ontology.allium
--
-- ORC's event-sourced semantic memory: static and learned concepts, Living
-- Descriptions, hybrid retrieval, and batch or incremental ontology building.

external entity OntologyConsumer {}
external entity EvaluationTrace { tree_id: String }

value ConceptDefinition {
    uri: String
    label: String
    description: String
    scope: ConceptScope
    broader_uris: List<String>
    indicators: List<String>
    provenance: ConceptProvenance
}

value ConceptProvenance {
    kind: ConceptOriginKind
    source_reference: String?
    created_by: String?
    trace_identifier: String?
}

value ConceptChanges {
    label: String?
    description: String?
    broader_uris: List<String>?
    indicators: List<String>?
}

value RelationshipMetadata {
    source_reference: String?
    trace_identifier: String?
}

value ModelProvenance {
    trace_identifier: String
    provider: String?
    model: String?
    resolved_models: List<String>?
    usage: Any?
    call_evidence: Any?
}

value Principle {
    trait: String
    context_guard: String
    recommendation: String
    confidence: Decimal
    evidence_count: Integer
}

value DescriptionBody {
    capabilities: List<String>
    strengths: List<Principle>
    weaknesses: List<Principle>
    representative_uses: List<String>
    avoid_when: List<String>
    summary: String
    version: Integer
    consolidated_event_count: Integer
    behavioral_subtree_identifiers: List<String>
}

-- One proposed change to a claim set. A consolidation emits a list of these
-- instead of a replacement body; the merge that applies them is deterministic.
value ClaimDelta {
    operation: ClaimOperation
    target_claim: String?
    kind: ClaimKind
    content: String
    context_guard: String?
    recommendation: String?
    episodes: List<String>
    from_legacy_corpus: Boolean
    -- Absent means judged_occurrences: every delta written before this field
    -- existed keeps exactly its old meaning, so a new field cannot loosen an
    -- old delta.
    evidence_basis: EvidenceBasis?
}

value SearchResult {
    document_identifier: String
    content: String
    graph_score: Decimal?
    embedding_score: Decimal?
    colbert_score: Decimal?
    fitness_score: Decimal?
    reasoning: String?
}

value BuildConfiguration {
    base_uri: String
    similarity_threshold: Decimal
    emit_same_as: Boolean
    include_metadata: Boolean
}

value SourceSpecification {
    source_uri: String?
    source_type: SourceType
    content: String?
    namespace: String?
    metadata: Any
}

value ResolutionSummary {
    exact_matches: Integer
    semantic_matches: Integer
    unmatched: Integer
}

contract TextEmbedding {
    embed: (text: String) -> List<Decimal>
    embed_batch: (texts: List<String>) -> List<List<Decimal>>

    @invariant ComparableDimensions
        -- Embeddings compared in one search use the same configured model.
}

contract SemanticReranking {
    rerank: (intent: String, candidates: List<SearchResult>) -> List<SearchResult>

    @invariant DeltaOnlyResults
        -- Reranking adds identity, reasoning, and bounded fitness; stored content
        -- and metadata are joined back after ranking.

    @invariant FailureIsVisible
        -- Timeout or malformed output is surfaced and original candidates survive.
}

contract OntologyExtraction {
    extract: (source: SourceSpecification, context: Any) -> Any

    @invariant SourceAwareExtraction
        -- CSV, JSON, SQL, RDF, and text retain provenance and use their extractor.

    @invariant DeterministicRdfImport
        -- N-Triples RDF import is deterministic: URI resources receive stable
        -- ontology-scoped identities and graph predicates join the same concept graph.

    @invariant LearnedArtifactModelProvenance
        -- Model-derived descriptions and source extractions retain the resolved
        -- model, trace identity, and usage that produced them.
}

contract CustomOntologyMutation {
    create_concept: (ontology: Ontology, definition: ConceptDefinition) -> Concept
    update_concept: (ontology: Ontology, concept: Concept, changes: ConceptChanges) -> Concept
    create_relationship: (source: Concept, target: Concept, predicate: String, metadata: RelationshipMetadata) -> ConceptRelationship

    @invariant TenantScopedMutation
        -- Every mutation resolves ontology and concept identity within the
        -- initiating consumer's tenant before an event can be emitted.
}

contract ScopedConceptLookup {
    get_ontology: (ontology_identifier: String) -> Ontology?
    list_ontologies: () -> List<Ontology>
    ontology_exists: (ontology_identifier: String) -> Boolean
    get_concept: (ontology: Ontology, uri: String) -> Concept?
    list_concepts: (ontology: Ontology) -> List<Concept>

    @invariant AmbiguityRejected
        -- A URI without ontology context resolves only when it identifies one
        -- concept globally; an ambiguous unscoped lookup returns no concept.

    @invariant CanonicalOntologyIdentity
        -- Equivalent supported external representations of an ontology
        -- identifier resolve to the same ontology identity.
}

enum ConceptScope {
    failure | success | problem | node_type | custom | tree_class | behavioral_subtree
}
enum SourceType { csv | json | sql | rdf | text }
enum BuildMode { batch | incremental }
enum BuildStatus { running | completed | failed }
enum DescriptionGranularity { node_type | node_instance | tree_fingerprint | tree_class | behavioral_subtree }
enum ConceptOriginKind {
    human_authored | agent_authored | source_extracted | imported | system_static
}

-- A Claim is the atomic unit of a Living Description: one insight carrying the
-- episodes it was derived from and support earned over time. Claim kinds mirror
-- the assembled body's sections; a claim's kind is MUTABLE, so an insight that
-- migrates between sections keeps its accumulated support.
enum ClaimKind { capability | strength | weakness | guard | representative_use }

-- candidate: recorded and visible, but not enforcing. validated: earned enough
-- post-guard evidence to influence retrieval ranking.
enum ClaimStatus { candidate | validated }

-- The complete set of operations a consolidation may express over a claim set.
-- Deletion is deliberately absent: a claim leaves only when its support decays
-- to zero.
enum ClaimOperation { add | support | contradict | edit }

-- What a delta's knowledge RESTS ON. Most claims rest on judged occurrences.
-- The others are deterministic writers whose evidence is real but is not a
-- judgement: a classification signature, an emitted artifact, or a body
-- converted from the pre-claim corpus. Declaring the basis is what lets those
-- writers through the evidence guard without pretending to be something they
-- are not — and a declaration is honoured ONLY when the delta names no
-- occurrence, so it can never excuse evidence that exists and failed.
-- authored: designer-written corpus knowledge. Authorship is a first-class
-- basis rather than a fabricated support count, so provenance stays honest
-- while curated guards keep the strength they were proven at.
enum EvidenceBasis {
    judged_occurrences | legacy_corpus | classification_signature
    | emitted_artifact | authored
}

-- Why a proposed delta was refused before it could become a claim. The guard
-- distinguishes "the judge had nothing to judge" from "this was judged badly" —
-- conflating them is the incident that motivated the guard.
enum EvidenceExclusionReason {
    no_judge_evidence | starved_evidence | judge_abstained
    | no_episodes | unverified_explanation
}

-- Calibrated values. They are stated here because two of them are coupled:
-- validation_support_threshold is DERIVED as the least support whose
-- confidence clears enforcement_confidence_floor under the curve
-- c(s) = s / (s + confidence_support_scale). Keeping them as independent
-- literals would make "validated implies confidence >= floor" true today and
-- silently false after the first re-tuning.
config {
    initial_claim_support: Integer = 2
    confidence_support_scale: Integer = 3
    enforcement_confidence_floor: Decimal = 0.6
    validation_support_threshold: Integer = 5
    description_recurrence_threshold: Integer = 2

    -- Harvest promotion. These three were REFERENCED BY NAME in
    -- PromoteWellScoredClass but never declared here (weed-2), so the rules read
    -- as though they were configured while the values lived only in code.
    -- Declaring them makes the drift visible and checkable.
    promotion_occurrence_threshold: Integer = 10
    maximum_shape_ratio: Decimal = 0.5
    -- The window `consistently_qualified` evaluates over. MEASURED consequence
    -- of its absence (grill GR-5): with the scalar lifetime mean the code uses
    -- instead, a class with 20 occurrences and FOUR catastrophic failures still
    -- promotes, at exactly 0.800. A mean cannot express "has qualified
    -- repeatedly" — only a window can, which is why no retuning of the
    -- threshold could ever have fixed it.
    consistency_window: Integer = 5
    -- The floor EACH occurrence in the window must clear. Deliberately not a
    -- mean over the window: that would reintroduce the same defect one level up.
    consistency_floor: Decimal = 0.8
    -- The floor EACH dimension (judge) must clear, per PromoteWellScoredClass's
    -- `quality.all(...)`. Referenced by that rule but never declared until now —
    -- the same omission as the three above.
    --
    -- DISTINCT AXIS from consistency_floor, and the distinction is the whole
    -- point: dimension_floor is across JUDGES at one moment; consistency_floor
    -- is across OCCURRENCES over time. The code collapsed both into one scalar
    -- mean, which is why a class could pass while failing catastrophically on
    -- one judge (needs >= 5 judges, latent) AND while failing catastrophically
    -- on 4 of 20 occurrences (needs only 1 judge, LIVE — measured).
    --
    -- Uniform for now because the system has exactly one judge. Per-dimension
    -- differentiation is a refinement, not a prerequisite.
    dimension_floor: Decimal = 0.8
}

entity Ontology {
    name: String
    scope: ConceptScope
    description: String?
    base_uri: String?
    created_at: Timestamp

    concepts: Concept with ontology = this
    builds: OntologyBuild with ontology = this
}

entity Concept {
    ontology: Ontology
    uri: String
    label: String
    description: String
    scope: ConceptScope
    provenance: ConceptProvenance
    broader_uris: List<String>
    indicators: List<String>
    embedding: List<Decimal>?
    created_at: Timestamp
    updated_at: Timestamp?

    outgoing: ConceptRelationship with source = this
    incoming: ConceptRelationship with target = this
}

entity ConceptRelationship {
    source: Concept
    target: Concept
    predicate: String
    metadata: RelationshipMetadata?
    created_at: Timestamp
}

entity TreeProfile {
    tree_id: String
    strengths: List<Principle>
    weaknesses: List<Principle>
    problem_mappings: Any
    learned_rules: Any
    embedding: List<Decimal>?
}

entity LivingDescription {
    granularity: DescriptionGranularity
    target_identifier: String
    -- Assembled from this description's claims; no longer authored wholesale.
    current_body: DescriptionBody
    -- The search key. NOT CURRENTLY PRODUCED — see ADR 0026. Retained as an
    -- optional field because the idea is deferred, not refuted in general: the
    -- measured payoff for description quality is at the LLM SELECTION layer,
    -- not at embedding rank, and that has never been measured here. Anything
    -- reading this must handle nil, which is the whole of its contract today.
    retrieval_description: String?
    -- The body's own revision counter, advanced per assembly.
    version: Integer
    -- DISTINCT from version: the optimistic-concurrency value, advanced per
    -- recorded claim-delta event (including one whose deltas all no-op). This
    -- is what a consolidation reads, what it must present unchanged to write,
    -- and what the append compares against.
    claim_set_version: Integer
    updated_at: Timestamp

    versions: DescriptionVersion with description = this
    claims: Claim with description = this
}

entity Claim {
    description: LivingDescription
    -- Deterministic identity derived from the recording event, so a rebuild
    -- from the log reproduces it byte-identically. This is what a delta's
    -- target_claim names and what every ordering tie-breaks on.
    claim_id: String
    kind: ClaimKind
    content: String
    context_guard: String?
    recommendation: String?
    -- Support is earned: seeded on creation, incremented by support/edit,
    -- decremented by contradict. A claim is removed only at zero.
    support: Integer
    status: ClaimStatus
    -- Occurrence identity, not event identity: the [source_sheet, source_tick]
    -- pair that identifies one turn. This is what lets a claim be re-pooled if
    -- the identity of its target ever changes.
    supporting_episodes: List<String>
    contradicting_episodes: List<String>
    -- true for claims converted from pre-claim bodies or re-derived from the
    -- historical rejection corpus. Legacy evidence counts toward support but
    -- cannot by itself validate a claim.
    legacy_provenance: Boolean
    -- Set at CREATION only; an edit operation preserves it. This is what stops
    -- a reworded authored guard from being laundered into weaker
    -- earned-evidence accounting.
    evidence_basis: EvidenceBasis?
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        candidate -> validated
        validated -> candidate
    }
}

entity DescriptionVersion {
    description: LivingDescription
    body: DescriptionBody
    recorded_at: Timestamp
    evidence_event_count: Integer
    model_provenance: ModelProvenance?
}

entity ConsolidationPolicy {
    target_type: String
    event_threshold: Integer
    hourly_budget: Integer
    enabled: Boolean
}

entity RegisteredSource {
    source_identifier: String
    source_uri: String?
    source_type: SourceType
    content_hash: String
    namespace: String?
    registered_at: Timestamp

    extractions: SourceExtraction with source = this
}

entity OntologyBuild {
    ontology: Ontology
    mode: BuildMode
    status: BuildStatus
    configuration: BuildConfiguration
    started_at: Timestamp
    completed_at: Timestamp?
    failure_reason: String?
    triple_count: Integer
    ttl_output: String?
    checksum: String?
    resolution: ResolutionSummary?

    transitions status {
        running -> completed
        running -> failed
        terminal: completed, failed
    }

    source_extractions: SourceExtraction with build = this
}

entity SourceExtraction {
    build: OntologyBuild
    source: RegisteredSource
    extracted_concept_count: Integer
    extracted_relationship_count: Integer
    extracted_schema: Any
    model_provenance: ModelProvenance?
}

entity CanonicalMapping {
    ontology: Ontology
    source_uri: String
    canonical_uri: String
    match_type: String
    similarity: Decimal
}

rule InitializeOntology {
    when: InitializeOntologyRequested(consumer, name, scope, description, base_uri)
    requires: nonblank(name)

    ensures: Ontology.created(
        name: name,
        scope: scope,
        description: description,
        base_uri: base_uri,
        created_at: now
    )
}

rule AddConcept {
    when: ConceptCreationRequested(ontology, definition)
    requires: nonblank(definition.uri)
    requires: nonblank(definition.label)
    requires: nonblank(definition.description)
    requires: ontology.concepts.none(concept => concept.uri = definition.uri)
    requires: definition.broader_uris.all(uri => ontology.concepts.any(concept => concept.uri = uri))

    ensures: Concept.created(
        ontology: ontology,
        uri: definition.uri,
        label: definition.label,
        description: definition.description,
        scope: definition.scope,
        provenance: definition.provenance,
        broader_uris: definition.broader_uris,
        indicators: definition.indicators,
        embedding: null,
        created_at: now,
        updated_at: null
    )
}

rule UpdateConcept {
    when: ConceptUpdateRequested(ontology, concept, changes)
    requires: concept.ontology = ontology
    requires: changes.label != null or changes.description != null or changes.broader_uris != null or changes.indicators != null
    requires: changes.label = null or nonblank(changes.label)
    requires: changes.description = null or nonblank(changes.description)
    requires: changes.broader_uris = null or changes.broader_uris.all(uri => ontology.concepts.any(candidate => candidate.uri = uri))
    ensures:
        if changes.label != null:
            concept.label = changes.label
        if changes.description != null:
            concept.description = changes.description
        if changes.broader_uris != null:
            concept.broader_uris = changes.broader_uris
        if changes.indicators != null:
            concept.indicators = changes.indicators
        concept.updated_at = now
}

rule LinkConcepts {
    when: RelationshipCreationRequested(source, target, predicate, metadata)
    requires: source != target
    requires: nonblank(predicate)
    requires: predicate in {"skos:broader", "skos:narrower", "skos:related", "behavior:composes-into"}
    requires: predicate = "behavior:composes-into" or source.ontology = target.ontology
    requires: source.outgoing.none(relationship => relationship.target = target and relationship.predicate = predicate)

    ensures: ConceptRelationship.created(
        source: source,
        target: target,
        predicate: predicate,
        metadata: metadata,
        created_at: now
    )
}

rule ClassifyEvaluationFailure {
    when: EvaluationClassified(trace, failure_uri, severity, triggers)

    ensures: TreeWeaknessRecorded(
        tree_id: trace.tree_id,
        failure_uri: failure_uri,
        severity: severity,
        triggers: triggers
    )
}

rule RecordSuccessfulPattern {
    when: SuccessfulTreeOutcomeObserved(trace, pattern_uri, confidence, context, action)

    ensures: TreeStrengthRecorded(
        tree_id: trace.tree_id,
        pattern_uri: pattern_uri,
        confidence: confidence,
        context: context,
        action: action
    )
}

rule ExtractLearnedRules {
    when: LearnedRuleExtractionRequested(tree_profile, minimum_confidence)
    requires: tree_profile.strengths.count + tree_profile.weaknesses.count > 0

    ensures: LearnedRulesExtracted(
        tree_id: tree_profile.tree_id,
        rules: infer_condition_action_rules(tree_profile, minimum_confidence)
    )
}

rule SeedBaselineDescriptions {
    when: BaselineCorpusSeedingRequested(consumer)

    ensures: BaselineDescriptionsRecorded(
        scopes: { node_type, tree_class, behavioral_subtree },
        preserve_history: true
    )
}

rule RequestThresholdConsolidation {
    when: RelevantLearningEventRecorded(target_type, target_identifier, delta)
    let policy = policy_for(target_type)
    requires: policy.enabled = true
    requires: delta >= policy.event_threshold
    requires: recent_consolidations(target_type) < policy.hourly_budget

    ensures: DescriptionConsolidationRequested(
        target_type: target_type,
        target_identifier: target_identifier
    )
}

-- Consolidation no longer proposes a replacement body. It proposes DELTAS over
-- the target's existing claims, and the merge is deterministic. Whole-body
-- rewriting is unrepresentable, which is what makes both failure modes
-- impossible: context collapse (an LLM compressing accumulated knowledge away)
-- and protection-induced starvation (a safeguard rejecting rephrased insight).
-- Evidence is judged PER DELTA, never per batch. One ungrounded delta must not
-- reject a consolidation's valid work — that all-or-nothing shape is the
-- protection-induced starvation this design exists to end, and it is why the
-- excluded deltas are recorded rather than silently dropped.
--
-- The claim-existence condition is enforced at the MERGE, not here: a delta
-- naming a claim that has since retired is a normal outcome of concurrent
-- learning, and the fold tolerates it as a no-op.
--
-- TRACKED GAP (CC-31): model provenance is not yet modeled on the delta path.
-- Upstream threads model_provenance through the whole-body description events
-- for replayability, and the retained description code path carries it — but
-- ClaimDeltasRecorded does not, in spec or code. The obligation is deliberate
-- and deferred, NOT forgotten: it lands as one slice (event field + command
-- schema + consolidator threading + this rule's binding) so spec and code move
-- together. Recording provenance per DELTA matters more than per body: claims
-- accrue across many consolidations, and diagnosing model drift needs to know
-- which model proposed each insight.
rule RecordClaimDeltas {
    when: DescriptionConsolidationCompleted(granularity, target_identifier, deltas, evidence_count, claim_set_version)
    let description = current_description(granularity, target_identifier)
    let grounded = deltas.filter(delta => evidence_is_grounded(delta))
    requires: claim_set_version = current_claim_set_version(description)
    requires: grounded.count > 0

    ensures: ClaimDeltasRecorded(
        granularity: granularity,
        target_identifier: target_identifier,
        deltas: grounded,
        evidence_event_count: evidence_count
    )
}

-- A delta whose evidence cannot be trusted is refused individually and the
-- refusal is recorded: a silent drop destroys the ability to measure how much
-- of our evidence was starved.
rule ExcludeUngroundedDelta {
    when: DescriptionConsolidationCompleted(granularity, target_identifier, deltas, evidence_count, claim_set_version)
    let ungrounded = deltas.filter(delta => evidence_is_grounded(delta) = false)
    requires: ungrounded.count > 0

    ensures: PromotionEvidenceExcluded(
        granularity: granularity,
        target_identifier: target_identifier,
        deltas: ungrounded
    )
}

-- When NOTHING survives the guard, no claim event is recorded and the
-- claim-set version deliberately does not advance — a consolidation that
-- produced no trustworthy knowledge must not look like one that did.
rule RecordNothingWhenAllDeltasExcluded {
    when: DescriptionConsolidationCompleted(granularity, target_identifier, deltas, evidence_count, claim_set_version)
    let grounded = deltas.filter(delta => evidence_is_grounded(delta))
    requires: claim_set_version = current_claim_set_version(description_for(granularity, target_identifier))
    requires: grounded.count = 0

    ensures: ClaimSetUnchanged(granularity: granularity, target_identifier: target_identifier)
}

-- A consolidation that reasoned over a stale claim set is refused, not merged:
-- concurrent consolidations must re-read rather than overwrite each other.
rule RefuseStaleClaimDeltas {
    when: DescriptionConsolidationCompleted(granularity, target_identifier, deltas, evidence_count, claim_set_version)
    let description = current_description(granularity, target_identifier)
    requires: claim_set_version != current_claim_set_version(description)

    ensures: ClaimDeltasRefused(
        granularity: granularity,
        target_identifier: target_identifier,
        reason: stale_claim_set
    )
}

rule ApplyAddClaim {
    when: ClaimDeltaApplied(description, delta)
    requires: delta.operation = add

    ensures: Claim.created(
        description: description,
        kind: delta.kind,
        content: delta.content,
        context_guard: delta.context_guard,
        recommendation: delta.recommendation,
        support: initial_claim_support,
        status: candidate,
        supporting_episodes: delta.episodes,
        contradicting_episodes: [],
        legacy_provenance: delta.from_legacy_corpus,
        -- Carried from the delta at creation and never rewritten afterwards;
        -- ValidateAuthoredClaimAtCreation then reads it to decide whether this
        -- claim is born enforcing. Naming it here is what makes
        -- Claim.evidence_basis's "set at CREATION only" true of the rules
        -- rather than only of the field comment.
        evidence_basis: delta.evidence_basis,
        created_at: now,
        updated_at: now
    )
}

-- support/edit reinforce; edit may also change a claim's KIND, so an insight
-- that migrates between body sections keeps the support it earned.
rule ReinforceClaim {
    when: ClaimDeltaApplied(description, delta)
    let claim = claim_for(description, delta.target_claim)
    requires: delta.operation = support or delta.operation = edit

    ensures: claim.support = claim.support + 1
    ensures: claim.supporting_episodes = claim.supporting_episodes + delta.episodes
    ensures: claim.updated_at = now
    -- An edit additionally rewords the claim and may migrate its kind, keeping
    -- the support it earned. Guards and advice are refreshed only when the
    -- delta supplies them: a silent edit must not erase what an earlier one
    -- established.
    ensures:
        if delta.operation = edit:
            claim.content = delta.content
    ensures:
        if delta.operation = edit:
            claim.kind = delta.kind
}

rule ContradictClaim {
    when: ClaimDeltaApplied(description, delta)
    let claim = claim_for(description, delta.target_claim)
    requires: delta.operation = contradict
    requires: claim.support > 1

    ensures: claim.support = claim.support - 1
    ensures: claim.contradicting_episodes = claim.contradicting_episodes + delta.episodes
    ensures: claim.updated_at = now
}

-- The ONLY removal path, and it removes the claim from the entity set rather
-- than moving it to a terminal state — which is why Claim's transition graph
-- has no `retired` member. A retirement record is kept so that "retired" stays
-- distinguishable from "silently deleted".
--
-- Derived safety property, worth stating because nothing enforces it directly:
-- retirement requires support <= 1 while validation requires support >= the
-- threshold, so a VALIDATED claim can never be retired in one step. It must be
-- demoted first.
rule RetireExhaustedClaim {
    when: ClaimDeltaApplied(description, delta)
    let claim = claim_for(description, delta.target_claim)
    requires: delta.operation = contradict
    requires: claim.support <= 1

    ensures: ClaimRetired(description: description, claim: claim, reason: support_exhausted)
}

-- A claim starts non-enforcing and earns the right to influence ranking with
-- evidence gathered under the evidence guard. Legacy evidence counts toward
-- support but cannot by itself validate.
-- The reverse edge, which had no witnessing rule: enforcement is continuously
-- earned, not granted once. A claim whose support decays below the threshold
-- returns to candidate rather than keeping a privilege it no longer merits.
-- Authored-basis claims are exempt: their support number was never a
-- threshold count, and their enforcement authority comes from authorship, not
-- accrual. They erode through the ordinary contradiction path instead — a
-- claim is removed when its support decays to zero.
rule DemoteUnderSupportedClaim {
    when: ClaimSupportChanged(description, claim)
    requires: claim.status = validated
    requires: claim.evidence_basis != authored
    requires: claim.support < validation_support_threshold

    ensures: claim.status = candidate
}

-- A claim created with basis authored is BORN validated: curated guards
-- enforce at full strength from day one (the alternative — seeding them as
-- candidates — silently disarms the proven regression corpus at seeding).
rule ValidateAuthoredClaimAtCreation {
    when: ClaimRecorded(description, claim)
    requires: claim.evidence_basis = authored

    ensures: claim.status = validated
}

rule ValidateWellSupportedClaim {
    when: ClaimSupportChanged(description, claim)
    requires: claim.status = candidate
    requires: claim.support >= validation_support_threshold
    requires: post_guard_episode_count(claim) > 0

    ensures: claim.status = validated
}

-- The body and the retrieval key are DERIVED from claims, never authored.
-- NOTE: assembly replaces the description's KNOWLEDGE, not the target's place
-- in the graph. The parent/scope/composes-into axes are carried forward from
-- the previous body, so landing a claim on a tree-class cannot silently
-- unparent it. Assembly is therefore not a pure function of the claims alone.
rule AssembleDescriptionFromClaims {
    when: ClaimSetChanged(description)

    ensures: description.current_body = assemble_body(description.claims)
    -- NOTE: assembly no longer synthesises a retrieval key. Measured null
    -- (ADR 0026): a synthesised key does not improve retrieval rank on this
    -- corpus, and while the key sat on the positive side of the domain
    -- penalty's own rerank call, improving it actively suppressed the guard.
    -- retrieval_description is therefore left unset rather than produced.
    ensures: description.version = description.version + 1
    ensures: description.updated_at = now
    ensures: DescriptionVersion.created(
        description: description,
        body: assemble_body(description.claims),
        recorded_at: now,
        evidence_event_count: evidence_count_for(description)
    )
}

-- HARVEST — the only automatic path that CREATES a durable behavior, and
-- previously unmodelled in this spec despite being shipped. Describing a class
-- is earned by RECURRENCE; promoting one is earned by CONSISTENT, per-dimension
-- quality. Separating them is what lets a recurring-but-mediocre class accrue an
-- honest account of what it is bad at.
rule DescribeRecurringClass {
    when: TreeClassOccurrenceRecorded(tree_class, occurrences)
    requires: occurrences >= description_recurrence_threshold

    ensures: DescriptionConsolidationRequested(
        target_type: tree_class_target,
        target_identifier: tree_class
    )
}

rule PromoteWellScoredClass {
    when: TreeClassOccurrenceRecorded(tree_class, occurrences)
    let quality = dimension_scores(tree_class)
    requires: occurrences >= promotion_occurrence_threshold
    requires: not already_harvested(tree_class)
    -- Per-dimension floors: one catastrophic dimension vetoes promotion, and
    -- cannot be compensated for by strength elsewhere.
    requires: quality.all(dimension => dimension.score >= dimension_floor(dimension))
    -- Consistency, not average: durable creation requires the class to have
    -- qualified repeatedly, so a single disastrous occurrence is not averaged away.
    requires: consistently_qualified(tree_class, consistency_window)
    -- Coherence: a tight cluster, not a grab-bag.
    requires: distinct_shape_ratio(tree_class) <= maximum_shape_ratio
    let parent = nearest_abstract_behavior(tree_class)
    requires: parent != null

    ensures: BehavioralSubtreeMinted(
        tree_class: tree_class,
        body: synthesised_behavior_body(tree_class),
        supporting_evidence: validated_claims(tree_class)
    )
}

-- Abstained evaluations carry no score and are SKIPPED by promotion, never
-- counted as zero. A judge that saw no evidence has not judged.
rule ExcludeAbstainedEvaluations {
    when: EvaluationAbstained(tree_class, occurrence)

    ensures: PromotionEvidenceExcluded(tree_class: tree_class, occurrence: occurrence)
}

rule MintNovelBehavior {
    when: NovelBehaviorConfirmed(tree_class, behavior_body, supporting_evidence)
    requires: supporting_evidence.count > 0

    ensures: BehavioralSubtreeMinted(
        tree_class: tree_class,
        body: behavior_body,
        supporting_evidence: supporting_evidence
    )
}

rule SearchOntologyMemory {
    when: OntologySearchRequested(consumer, ontology, query, scopes, limit, rerank)
    requires: limit > 0
    let graph_candidates = spreading_activation(ontology, query, scopes)
    let semantic_candidates = embedding_search(ontology, query, scopes)
    let fused = reciprocal_rank_fusion(graph_candidates, semantic_candidates)

    ensures: OntologySearchCompleted(
        consumer: consumer,
        results: optionally_rerank(fused, query, rerank).take(limit)
    )
}

rule SearchLivingDescriptions {
    when: DescriptionSearchRequested(consumer, intent, granularities, limit, rerank)
    requires: limit > 0

    ensures: DescriptionSearchCompleted(
        consumer: consumer,
        results: search_description_corpus(intent, granularities, rerank).take(limit)
    )
}

rule StartBatchBuild {
    when: BuildFromSourcesRequested(consumer, name, scope, sources, configuration)
    requires: sources.count > 0
    let ontology = new_ontology(name, scope, configuration.base_uri)

    ensures: OntologyBuild.created(
        ontology: ontology,
        mode: batch,
        status: running,
        configuration: configuration,
        started_at: now,
        completed_at: null,
        failure_reason: null,
        triple_count: 0,
        ttl_output: null,
        checksum: null,
        resolution: null
    )
    ensures: SourcesSubmittedForExtraction(build: created, sources: sources)
}

rule StartIncrementalBuild {
    when: EvolveOntologyRequested(consumer, ontology, sources, configuration)
    requires: sources.count > 0

    ensures: OntologyBuild.created(
        ontology: ontology,
        mode: incremental,
        status: running,
        configuration: configuration,
        started_at: now,
        completed_at: null,
        failure_reason: null,
        triple_count: 0,
        ttl_output: null,
        checksum: null,
        resolution: null
    )
    ensures: SourcesSubmittedForExtraction(build: created, sources: sources)
}

rule RegisterUniqueSource {
    when: SourceRegistrationRequested(build, specification, content_hash)
    requires: no_registered_source_has_hash(content_hash)

    ensures: RegisteredSource.created(
        source_identifier: new_identifier(),
        source_uri: specification.source_uri,
        source_type: specification.source_type,
        content_hash: content_hash,
        namespace: specification.namespace,
        registered_at: now
    )
    ensures: SourceExtractionRequested(build: build, source: created)
}

rule SkipDuplicateSource {
    when: SourceRegistrationRequested(build, specification, content_hash)
    requires: no_registered_source_has_hash(content_hash) = false

    ensures: DuplicateSourceSkipped(build: build, source: source_with_hash(content_hash))
}

rule RecordSourceExtraction {
    when: SourceExtractionCompleted(build, source, concepts, relationships, schema, model_provenance)
    requires: build.status = running

    ensures: SourceExtraction.created(
        build: build,
        source: source,
        extracted_concept_count: concepts.count,
        extracted_relationship_count: relationships.count,
        extracted_schema: schema,
        model_provenance: model_provenance
    )
    ensures: ExtractedGraphContributionRecorded(
        build: build,
        source: source,
        concepts: concepts,
        relationships: relationships
    )
}

rule ResolveAndMergeBuild {
    when: AllBuildSourcesExtracted(build)
    requires: build.status = running
    let resolution = resolve_entities_by_type_then_similarity(build)

    ensures: CanonicalMappingsRecorded(build: build, resolution: resolution)
    ensures: UnifiedGraphMerged(build: build, resolution: resolution)
    ensures: TurtleSnapshotRequested(build: build)
}

rule CompleteBuild {
    when: TurtleSnapshotCreated(build, ttl_output, triple_count, checksum, resolution)
    requires: build.status = running

    ensures: build.status = completed
    ensures: build.completed_at = now
    ensures: build.ttl_output = ttl_output
    ensures: build.triple_count = triple_count
    ensures: build.checksum = checksum
    ensures: build.resolution = resolution
    ensures: OntologyBuildCompleted(build: build)
}

rule FailBuild {
    when: OntologyBuildCannotContinue(build, reason)
    requires: build.status = running

    ensures: build.status = failed
    ensures: build.completed_at = now
    ensures: build.failure_reason = reason
    ensures: OntologyBuildFailed(build: build, reason: reason)
}

invariant ConceptUrisAreUniqueWithinOntology {
    for a in Concepts:
        for b in Concepts:
            a != b and a.ontology = b.ontology implies a.uri != b.uri
}

invariant RelationshipsStayWithinOntology {
    for relationship in ConceptRelationships:
        relationship.predicate != "behavior:composes-into" implies
            relationship.source.ontology = relationship.target.ontology
}

invariant RelationshipEdgesAreUnique {
    for a in ConceptRelationships:
        for b in ConceptRelationships:
            a != b implies a.source != b.source or a.target != b.target or a.predicate != b.predicate
}

invariant DescriptionHistoryIsAppendOnly {
    for version in DescriptionVersions:
        version.recorded_at <= version.description.updated_at
}

invariant DescriptionConfidenceIsBounded {
    for description in LivingDescriptions:
        description.current_body.strengths.all(principle => principle.confidence >= 0 and principle.confidence <= 1)
        and description.current_body.weaknesses.all(principle => principle.confidence >= 0 and principle.confidence <= 1)
}

-- Claims leave only by decay. No consolidation, and no single judgement, can
-- delete accumulated knowledge outright.
invariant ClaimsAreRetiredOnlyWhenUnsupported {
    for claim in Claims:
        claim.support >= 1
}

-- CC-21b verified a MISSING PRODUCER: DescriptionConsolidationCompleted appears
-- four times as a `when:` trigger and ZERO times as an `ensures:`, and it is not
-- declared as an external/surface stimulus either. By contrast
-- DescriptionConsolidationRequested has two producers. So the arc
-- Requested -> Completed models the request and not the reflection call that
-- answers it — the LLM step itself is unmodelled.
--
-- That is why its FAILURE has nowhere to be recorded. Measured: on the target
-- taking 23.4% of all consolidation requests, the provider rejected the prompt
-- outright (1,571,414 tokens against a 1,048,576 limit), 0/3 successful after
-- four retries each, leaving NO event at all. The read model counting
-- recent_consolidations cannot distinguish "23.4% of requests died" from
-- "everything is fine".
--
-- The sibling subsystem already has the shape of the answer: contract
-- SemanticReranking carries @invariant FailureIsVisible ("Timeout or malformed
-- output is surfaced and original candidates survive"). Consolidation has no
-- equivalent.
--
-- NOT resolved here by inventing a producer rule: modelling the reflection step
-- is spec DESIGN, not a tend, and it should be decided deliberately alongside
-- the consolidation-side failure contract. Tracked as CC-28.
--
-- ⚠ TOOLING NOTE, verified: this Allium version does NOT parse `open question`.
-- The construct is in the language reference and documented as surfacing a
-- checker warning, but `allium model` has no `open_questions` key and the text
-- does not appear in the parsed model — so writing one here would READ as
-- tracked while nothing tracked it. That is the same class of defect this arc
-- keeps finding, so the decision is tracked in the issue system instead and
-- this comment is documentation for the reader, nothing more.

-- Enforcement (retrieval ranking) acts on validated claims only; candidates are
-- visible to the model but cannot suppress a behavior's retrieval.
invariant OnlyValidatedClaimsEnforce {
    for claim in Claims:
        claim.status = validated implies
            (post_guard_episode_count(claim) > 0 or claim.evidence_basis = authored)
}

-- Every claim can be re-pooled from its own provenance. This is what keeps a
-- future re-partition of class identity (cluster splitting) possible: claims
-- follow their evidence rather than being orphaned by it.
invariant ClaimsCarryResolvableProvenance {
    for claim in Claims:
        claim.supporting_episodes.count > 0
        or declared_basis(claim) != judged_occurrences
}

invariant ContentHashesDeduplicateSources {
    for a in RegisteredSources:
        for b in RegisteredSources:
            a != b implies a.content_hash != b.content_hash
}

invariant BuildResolutionScoresAreBounded {
    for mapping in CanonicalMappings:
        mapping.similarity >= 0 and mapping.similarity <= 1
}

invariant CompletedBuildHasSnapshot {
    for build in OntologyBuilds:
        build.status = completed implies
            build.ttl_output != null and build.checksum != null and build.completed_at != null
}

surface SemanticMemory {
    facing consumer: OntologyConsumer

    provides:
        InitializeOntologyRequested(consumer, name, scope, description, base_uri)
        ConceptCreationRequested(ontology, definition)
        ConceptUpdateRequested(ontology, concept, changes)
        RelationshipCreationRequested(source, target, predicate, metadata)
        BaselineCorpusSeedingRequested(consumer)
        LearnedRuleExtractionRequested(tree_profile, minimum_confidence)
        OntologySearchRequested(consumer, ontology, query, scopes, limit, rerank)
        DescriptionSearchRequested(consumer, intent, granularities, limit, rerank)
        BuildFromSourcesRequested(consumer, name, scope, sources, configuration)
        EvolveOntologyRequested(consumer, ontology, sources, configuration)

    exposes:
        Ontology
        Concept
        ConceptRelationship
        TreeProfile
        LivingDescription
        RegisteredSource
        OntologyBuild
        CanonicalMapping

    contracts:
        demands TextEmbedding
        demands SemanticReranking
        fulfils OntologyExtraction
        fulfils ScopedConceptLookup

    @guarantee ScopedMemory
        -- Concept identity and traversal remain ontology scoped. Compatibility
        -- URI lookup never guesses when multiple ontologies contain the URI.

    @guarantee TenantBoundary
        -- Every command, query, statistic, source, learned artifact, build, and
        -- canonical mapping is evaluated within the caller's tenant. Equal
        -- identifiers in a shared store never grant cross-tenant visibility.

    @guarantee AuditableEvolution
        -- Graph changes, description versions, sources, resolution decisions,
        -- and snapshots remain reconstructable from events.

    @guarantee RetrySafeMutation
        -- Repeating a lifecycle mutation with the same command identity returns
        -- the same generated domain identity and appends no duplicate mutation.

    @guarantee UnifiedManualAndExtractedGraph
        -- Evolution recognizes manually created ontology and concept events;
        -- manually authored URI identities remain canonical when extracted
        -- source material refers to the same concept.

    @guarantee ReadWriteOptInSeparation
        -- Description retrieval and description-writing consolidation are
        -- independently enabled.

    @guarantee ExactIdentitySurvivesRerankerFailure
        -- A failed semantic reranker normally leaves classification uncertain.
        -- A behavioral candidate may still match when its canonical summary
        -- contains every meaningful token of a multi-token query; this narrow
        -- deterministic identity check does not authorize similarity guesses.
}
