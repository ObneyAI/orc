-- allium: 3
-- colbert.allium
--
-- Scope: event-audited late-interaction indexing, retrieval, score
-- normalization, batching, and in-memory reranking.
-- Includes: rebuildable index source data, passage splitting constraints,
-- exact token-level scoring, document aggregation, soft deletion, RRF-shaped
-- results, and encoder lifecycle.
-- Excludes: DJL/ONNX/tokenizer APIs, binary artifact layout, filesystem cache,
-- model download mechanics, Grain plumbing, and the historical Python bridge.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity RetrievalConsumer {}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value DocumentMetadata {
    value: Any
}

value IndexConfiguration {
    model_name: String
    split_documents: Boolean
    maximum_passage_tokens: Integer
    -- The query-side counterpart. Modelled because it has the same character as
    -- maximum_passage_tokens — a configured limit that changes retrieval
    -- behaviour by discarding content — and because its absence hid a live
    -- defect: 42% of measured queries exceeded it and were silently truncated,
    -- losing up to 14 word-piece tokens, with no signal to any caller.
    -- It is also the encoder's per-query row count, so it sets the score
    -- ceiling that every downstream threshold is calibrated against.
    maximum_query_tokens: Integer
}

-- A query longer than the configured limit is TRUNCATED, not rejected: the
-- excess tokens are discarded and retrieval proceeds against the prefix.
-- Stated because the discard is otherwise invisible — a caller cannot tell a
-- fully-matched query from a truncated one, and a retrieval key can never be
-- matched against text the encoder did not see.
value SearchResult {
    content: String
    score: Decimal
    rank: Integer
    document_identifier: String?
    document_metadata: DocumentMetadata?
}

value FusionResult {
    uri: String
    score: Decimal
}

value NormalizationOptions {
    method: linear | sigmoid | batch_relative
    maximum_score: Decimal?
    minimum_score: Decimal?
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract LateInteractionRetrieval {
    search: (index: RetrievalIndex, query: String, count: Integer) -> List<SearchResult>
    search_batch: (index: RetrievalIndex, queries: List<String>, count: Integer) -> List<List<SearchResult>>
    rerank: (query: String, documents: List<String>, count: Integer) -> List<SearchResult>
    normalize_score: (score: Decimal, options: NormalizationOptions) -> Decimal
    normalize_results: (results: List<SearchResult>, options: NormalizationOptions) -> List<SearchResult>
    search_for_fusion: (index: RetrievalIndex, query: String, count: Integer, weight: Decimal) -> List<FusionResult>

    @invariant ExactLateInteraction
        -- A query-document score is the sum, over query token rows, of each
        -- row's maximum similarity to eligible document token rows.

    @invariant PassageAggregation
        -- A document's search score and content come from its highest-scoring
        -- passage, and each document appears at most once in results.

    @invariant DescendingStableRanks
        -- Results are ordered by descending score and carry consecutive
        -- one-based ranks after limiting.

    @invariant BatchAlignment
        -- Batch output contains one result list per query in input order, and
        -- each list is equivalent to searching that query individually.

    @invariant BoundedNormalization
        -- Normalized scores lie from zero through one while preserving relative
        -- order among retained results.

    @invariant FusionIdentity
        -- Fusion results retain the source document identifier as their URI and
        -- apply the requested weight after optional normalization.
}

contract RebuildableIndexArtifact {
    rebuild: (index: RetrievalIndex) -> Any
    release_encoders: () -> Any

    @invariant SourceOfTruth
        -- The durable index record retains source documents, identifiers,
        -- metadata, model identity, and splitting configuration sufficient to
        -- rebuild a lost derived index artifact.

    @invariant CompatibleArtifact
        -- An incompatible, incomplete, or unreadable derived artifact is
        -- rejected with a rebuild remedy instead of being searched silently.
}

contract AtomicAliasActivation {
    activate: (alias: String, index: RetrievalIndex) -> Any
    resolve: (alias: String) -> RetrievalIndex

    @invariant OneResolvedSnapshot
        -- An alias resolves to exactly one complete immutable index snapshot;
        -- searches never observe an activation in progress or combine snapshots.

    @invariant FailurePreservesPriorActivation
        -- If the requested index is absent, deleted, or otherwise unusable,
        -- activation is rejected and the alias continues to resolve to its
        -- previously active snapshot.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum IndexStatus { active | deleted }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity RetrievalIndex {
    name: String
    status: IndexStatus
    documents: List<String>
    document_identifiers: List<String>
    document_metadatas: List<DocumentMetadata>?
    document_count: Integer
    passage_count: Integer
    configuration: IndexConfiguration
    created_at: Timestamp
    deleted_at: Timestamp when status = deleted

    transitions status {
        active -> deleted
        terminal: deleted
    }
}

entity RetrievalAlias {
    name: String
    index: RetrievalIndex
    activated_at: Timestamp
}

entity SearchAudit {
    index: RetrievalIndex
    query: String
    requested_count: Integer
    result_count: Integer
    top_score: Decimal?
    -- CC-17: what the encoder actually saw. Recorded because the discard is
    -- otherwise invisible, and 100% of real production queries were exceeding
    -- the limit while every audit record looked normal.
    -- OPTIONAL by necessity, not by preference: these fields accreted onto an
    -- existing event, so audits recorded before CC-17 do not carry them. The
    -- invariant below is guarded accordingly rather than asserting over history
    -- that cannot satisfy it.
    query_token_count: Integer?
    truncated: Boolean?
    discarded_token_count: Integer?
    -- The limit the encoder ACTUALLY applied. Distinct from
    -- index.configuration.maximum_query_tokens: an index created before CC-17
    -- carries no configured limit, so the encoder falls back to the process
    -- default. Comparing against the index's configuration would therefore
    -- assert a relationship the code does not have.
    maximum_query_tokens: Integer?
    performed_at: Timestamp
}

entity RerankAudit {
    query: String
    input_count: Integer
    output_count: Integer
    top_score: Decimal?
    -- Rerank truncates by the same mechanism and needs the same visibility,
    -- even though it has no index and therefore no IndexConfiguration. Optional
    -- for the same event-accretion reason as SearchAudit.
    query_token_count: Integer?
    truncated: Boolean?
    discarded_token_count: Integer?
    maximum_query_tokens: Integer?
    performed_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule CreateRetrievalIndex {
    when: CreateRetrievalIndex(consumer, name, documents, document_identifiers, document_metadatas, configuration)
    requires: documents.count = document_identifiers.count
    requires: document_metadatas = null or document_metadatas.count = documents.count
    requires: configuration.maximum_passage_tokens > 0
    -- CC-17 added this validation in code (positive, above the query specials,
    -- and within the checkpoint's position-embedding limit) but the rule was
    -- not tended in the same edit. Weed caught the omission.
    requires: configuration.maximum_query_tokens > 0

    ensures: RetrievalIndex.created(
        name: name,
        status: active,
        documents: documents,
        document_identifiers: document_identifiers,
        document_metadatas: document_metadatas,
        document_count: documents.count,
        passage_count: resulting_passage_count(documents, configuration),
        configuration: configuration,
        created_at: now,
        deleted_at: null
    )
}

rule DeleteRetrievalIndex {
    when: DeleteRetrievalIndex(consumer, index)
    requires: index.status = active

    ensures: index.status = deleted
    ensures: index.deleted_at = now
}

rule ActivateRetrievalAlias {
    when: ActivateRetrievalAlias(consumer, alias_name, index)
    requires: index.status = active
    let alias = RetrievalAlias{name: alias_name}

    ensures:
        if exists alias:
            alias.index = index
            alias.activated_at = now
        else:
            RetrievalAlias.created(name: alias_name, index: index, activated_at: now)
}

rule SearchRetrievalAlias {
    when: SearchRetrievalAlias(consumer, alias, query, count)
    requires: alias.index.status = active
    requires: count >= 0
    let results = late_interaction_search(alias.index, query, count)

    ensures: SearchAudit.created(
        index: alias.index,
        query: query,
        requested_count: count,
        result_count: results.count,
        top_score: if results.count > 0: results.first.score else: null,
        performed_at: now
    )
    ensures: SearchResultsReturned(consumer: consumer, results: results)
}

rule SearchActiveIndex {
    when: SearchActiveIndex(consumer, index, query, count)
    requires: index.status = active
    requires: count >= 0
    let results = late_interaction_search(index, query, count)

    ensures: SearchAudit.created(
        index: index,
        query: query,
        requested_count: count,
        result_count: results.count,
        top_score: if results.count > 0: results.first.score else: null,
        query_token_count: query_token_count(query),
        truncated: query_token_count(query) > applied_query_limit(index),
        discarded_token_count: max(0, query_token_count(query) - applied_query_limit(index)),
        maximum_query_tokens: applied_query_limit(index),
        performed_at: now
    )
    ensures: SearchResultsReturned(consumer: consumer, results: results)
}

rule RerankDocuments {
    when: RerankDocuments(consumer, query, documents, count)
    requires: count >= 0
    let results = late_interaction_rerank(query, documents, count)

    ensures: RerankAudit.created(
        query: query,
        input_count: documents.count,
        output_count: results.count,
        top_score: if results.count > 0: results.first.score else: null,
        performed_at: now
    )
    ensures: SearchResultsReturned(consumer: consumer, results: results)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- CC-17. Split into two named invariants (weed finding b): the first draft put
-- two sibling quantifiers in one body with no connective, which parses but has
-- no defined meaning and rebinds the same name twice. Each arm now carries its
-- own obligation id.
--
-- Guarded on presence (weed findings d/e): the fields accreted onto existing
-- events, so audits predating CC-17 do not carry them, and an index predating
-- CC-17 carries no configured limit. The comparison is therefore against the
-- limit the encoder ACTUALLY applied, which is what the implementation records
-- and what makes the assertion true rather than aspirational.
invariant OverlongSearchQueriesTruncateVisibly {
    for audit in SearchAudits:
        audit.truncated != null implies
            audit.truncated = (audit.query_token_count > audit.maximum_query_tokens)
}

invariant OverlongRerankQueriesTruncateVisibly {
    for audit in RerankAudits:
        audit.truncated != null implies
            audit.truncated = (audit.query_token_count > audit.maximum_query_tokens)
}

invariant AlignedIndexSourceData {
    for index in RetrievalIndexes:
        index.documents.count = index.document_identifiers.count
        and (index.document_metadatas = null or index.document_metadatas.count = index.documents.count)
}

invariant UniqueDocumentIdentifiersWithinIndex {
    for index in RetrievalIndexes:
        index.document_identifiers.unique.count = index.document_identifiers.count
}

invariant UniqueRetrievalAliasName {
    for a in RetrievalAliases:
        for b in RetrievalAliases:
            a != b implies a.name != b.name
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ColbertRetrieval {
    facing consumer: RetrievalConsumer

    provides:
        CreateRetrievalIndex(consumer, name, documents, document_identifiers, document_metadatas, configuration)
        DeleteRetrievalIndex(consumer, index)
        ActivateRetrievalAlias(consumer, alias_name, index)
        SearchRetrievalAlias(consumer, alias, query, count)
        SearchActiveIndex(consumer, index, query, count)
        RerankDocuments(consumer, query, documents, count)

    contracts:
        fulfils LateInteractionRetrieval
        fulfils RebuildableIndexArtifact
        fulfils AtomicAliasActivation

    @guarantee DeletedIndexesAreNotSearchable
        -- Soft deletion preserves rebuild source data and audit history but
        -- rejects subsequent indexed searches.
}
