-- allium: 3
-- observability.allium
--
-- Scope: optional forwarding of ORC trace, span, and generation events to an
-- external observability service.
-- Includes: client configuration, batching, disabled behavior, managed
-- background export, bounded buffering, acknowledgement, retries, explicit
-- drops, status snapshots, failure isolation, and bounded shutdown.
-- Excludes: HTTP, JSON, Basic authentication, environment lookup, host defaults,
-- and Langfuse-specific endpoint construction.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity OrcRuntime {}

config {
    queue_capacity: Integer = 256
    maximum_export_attempts: Integer = 3
    shutdown_timeout: Duration = 2.seconds
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ObservabilityConfiguration {
    destination: String
    public_credential: String?
    secret_credential: String?

    enabled: public_credential != null and secret_credential != null
}

value ObservabilityEvent {
    identifier: String
    occurred_at: Timestamp
    kind: trace | span | generation
    body: Any
}

value IngestionResult {
    attempted: Boolean
    accepted: Boolean
    response_status: Integer?
    response_body: String?
}

value ExporterStatistics {
    offered: Integer
    accepted: Integer
    retried: Integer
    dropped: Integer
    failures: Integer
    occupancy: Integer
    capacity: Integer
    accepted_identifiers: List<String>
    dropped_identifiers: List<String>
    running: Boolean
    stopped: Boolean?
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract TraceExporter {
    create_configuration: () -> ObservabilityConfiguration
    ingest: (configuration: ObservabilityConfiguration, events: List<ObservabilityEvent>) -> IngestionResult

    @invariant DisabledExporterIsInert
        -- A missing credential or an empty event batch produces no remote
        -- ingestion attempt.

    @invariant BatchIntegrity
        -- When enabled, one ingestion request contains every supplied event in
        -- input order and reports whether the destination accepted the batch.

    @guidance
        -- Callers may continue execution after a rejected observability batch;
        -- the result makes the failure explicit for their own policy decision.
}

contract ManagedTraceExporter {
    start: (runtime: OrcRuntime, event_kinds: Set<String>) -> Any
    statistics: (exporter: Any) -> ExporterStatistics
    stop: (exporter: Any) -> ExporterStatistics

    @invariant NonBlockingPublication
        -- Runtime publication never waits for remote export. Events enter a
        -- bounded queue; a full queue causes an explicit recorded drop.

    @invariant AcknowledgementIntegrity
        -- An event is accepted only when the destination acknowledges that
        -- event's durable identity. Missing acknowledgements and exceptions
        -- are retried up to the configured attempt limit, then recorded as a
        -- drop rather than silently treated as success.

    @invariant OrderedSingleEventProgress
        -- One worker advances through queued events in source order and does
        -- not advance past an unacknowledged event until it is retried or
        -- explicitly dropped.

    @invariant FailureIsolation
        -- Export exceptions and destination rejection remain observable in
        -- statistics but cannot fail or backpressure workflow execution.

    @invariant BoundedStop
        -- Stop rejects new work, drains queued work within the configured
        -- shutdown timeout, then reports whether the worker actually stopped.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RuntimeObservabilityIntegration {
    facing runtime: OrcRuntime

    contracts:
        fulfils TraceExporter
        fulfils ManagedTraceExporter

    @guarantee OptionalIntegration
        -- ORC behavior remains available when export configuration is absent.
}
