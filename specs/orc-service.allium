-- allium: 3
-- orc-service.allium
--
-- Scope: the public behavior of ORC's behavior-tree authoring, versioning,
-- execution, delegation, RLM exploration, tracing, streaming, and cancellation.
-- Includes: workflow and node structure, typed blackboards, immutable published
-- versions, isolated executions, node outcomes, value attribution, retry,
-- partial/blocked/timeout outcomes, and parent-child execution lineage.
-- Excludes: Grain command/event plumbing, Malli representation, Clojure/SCI
-- mechanics, HTTP/provider details, logging, layout coordinates, caches, and
-- serialization formats.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity WorkflowConsumer {}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value DataSchema {
    definition: Any
    is_specific: not contains_unconstrained_type(definition)

    @invariant StructuralSpecificity
        -- A schema is not specific when it contains :any or :some, uses a
        -- standalone or fieldless map, or declares a collection without a
        -- specific item/value schema. Specificity applies recursively.
}

value BlackboardValue {
    value: Any
}

value NodeConfiguration {
    value: Any
}

value RetryPolicy {
    maximum_attempts: Integer
    backoff: List<Duration>
}

value ExecutionOptions {
    timeout: Duration?
    maximum_ticks: Integer?
    llm_call_budget: Integer?
    version_number: Integer?
    force_draft: Boolean
    correlation_identifier: String?
}

value Usage {
    prompt_tokens: Integer?
    completion_tokens: Integer?
    total_tokens: Integer?
}

value ProviderFailureEvidence {
    provider: String
    model: String?
    response_identifier: String?
    finish_reason: String?
    tool_call_present: Boolean
    tool_call_name: String?
    usage: Usage?
    output_truncated: Boolean
}

value StreamEnvelope {
    sequence_number: Integer
    occurred_at: Timestamp
    execution_identifier: String
    kind: String
    body: Any
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract LeafExecutor {
    execute: (configuration: NodeConfiguration, inputs: Any) -> Any

    @invariant ConsumerCodeIsExecutable
        -- A deterministic code leaf may name callable behavior supplied by the
        -- workflow consumer. Successful execution does not require that the
        -- callable be owned by ORC.

    @invariant ConfiguredConsumerToolGateIsAuthoritative
        -- When a researcher names a consumer-supplied tool gate, every inline
        -- tool call and every tool call from its generated subtree uses that
        -- gate with the execution's durable consumer context. A configured gate
        -- that cannot be resolved or constructed fails the node; it never falls
        -- back to an ungated caller. With no configured gate, the ordinary tool
        -- caller remains available for backwards compatibility.

    @invariant ResearcherSeesBoundToolContracts
        -- Before calling a bound tool, a researcher's Phase-1 model receives
        -- that tool's authoritative argument and result schemas. Nested,
        -- closed, optional, collection and union semantics remain intact.
        -- Bound tools whose declarations omit either schema remain callable
        -- and identify the missing side explicitly as untyped. Unbound tool
        -- declarations are never exposed.

    @invariant ResearcherSeesMintBehaviorContract
        -- Whenever mint-behavior! is available in the researcher sandbox, the
        -- Phase-1 model receives the authoritative behavioral-description body
        -- schema and the call's name, body, and optional-parent shape before it
        -- generates code. The contract is present even when corpus
        -- auto-classification and contextual pattern injection are disabled;
        -- optional retrieval guidance may illustrate the contract but is never
        -- its sole source.

    @invariant DeclaredInputsOnly
        -- A leaf receives only the blackboard values named by its read contract.

    @invariant DeclaredOutputsOnly
        -- A successful leaf supplies a non-null value for every required key
        -- named by its write contract, supplies no undeclared keys, and every
        -- supplied value satisfies the key's declared schema. A leaf may name
        -- top-level writes as optional according to that executor's documented
        -- absence-normalization policy; a value normalized to absence is not
        -- written durably.

    @invariant ResearcherSeesDeclaredOutputContract
        -- Before designing or finalizing work, a researcher's Phase-1 model
        -- receives every declared write key paired with its authoritative
        -- blackboard schema. Structured, closed, optional, collection, union,
        -- and scalar schema semantics remain intact, so consumers do not need
        -- to duplicate output shapes in task instructions.

    @invariant ResearcherFinalizationUsesDeclaredSchemas
        -- Values supplied through a researcher's finalization operation cross
        -- the same declared-output validation boundary as every other leaf.
        -- Invalid values fail the node with attributable schema evidence and
        -- never become durable execution values.

    @invariant ResearcherOptionalWritesPreserveNestedSchemas
        -- A researcher may omit a declared top-level optional write, or supply
        -- a literal null that is normalized to absence. Any present non-null
        -- value, including a structured value whose nested fields are null,
        -- still crosses its complete declared schema boundary. Top-level write
        -- optionality never changes nested-field nullability.

    @invariant ResearcherBlankCodeIsRecoverable
        -- While recursive Phase-1 iteration and execution budgets remain, a
        -- model response that contains no executable code and no provider
        -- error becomes attributable iteration evidence for the next turn; it
        -- does not fail the researcher immediately. Repeated empty responses
        -- consume the ordinary iteration budget and fail clearly when that
        -- budget is exhausted. Provider, security, cancellation, and execution
        -- budget failures retain their existing terminal semantics.

    @invariant ProviderRetryCoversSchemaFailure
        -- The default provider retry applies when a returned structured output
        -- violates its declared schema, as well as when the provider attempt
        -- fails by exception. Only the final exhausted schema failure becomes
        -- durable rejected-output evidence.

    @invariant ProviderAttemptsShareExecutionBudgets
        -- Provider retries and node retries may compose, but every actual
        -- provider invocation consumes the shared LLM-call budget and the
        -- execution's remaining wall-clock budget. ORC does not begin an
        -- invocation or retry backoff after that remaining budget is exhausted.

    @invariant ProviderEnumSpellingsAreJsonCanonical
        -- Every provider-facing schema representation, including textual
        -- descriptions and function-calling tool definitions, renders
        -- keyword-valued enum choices in their canonical JSON spelling without
        -- an EDN leading colon. Before validation, a provider's canonical JSON
        -- string is decoded to the declared keyword at every schema depth,
        -- including maps, collections, intersections, unions and discriminated
        -- variants. String-valued enums remain strings, while colon-prefixed or
        -- otherwise noncanonical spellings remain invalid provider output. The
        -- same normalization applies to textual, function-calling and streaming
        -- structured responses.

    @invariant ProviderStructuredOutputsRemainStructured
        -- Function-calling tool definitions preserve structured Malli schemas,
        -- including schema-level properties, nullable wrappers, unions of map
        -- variants and their discriminators. Adding descriptive or validation
        -- properties to a schema does not change its provider-facing JSON type.
        -- Provider objects and collections arrive at leaf validation as parsed
        -- values, never as JSON encoded inside strings.

    @invariant FlattenedOutputPresenceIsPreserved
        -- When a structured output is presented to a provider as separate
        -- fields, required and optional map-entry presence retains the meaning
        -- of the original schema. Omitted optional entries and explicit nulls
        -- for optional entries whose schemas reject null remain absent when the
        -- provider result is reassembled. Required entries remain present, and
        -- entries whose schemas accept null preserve it, in both textual and
        -- function-calling transports.

    @invariant StructuredProviderFailuresRemainDiagnosable
        -- Every failed structured provider execution records either sanitized
        -- response evidence captured before decoding or an explicit transport
        -- failure. Missing forced tool calls, malformed tool arguments, and
        -- schema-invalid decoded arguments have distinct stable failure kinds.
        -- Evidence retains available usage and finish reason even when no text
        -- exists, and excludes arbitrary provider payloads and tool arguments.
}

contract WorkflowDefinitionConstruction {
    build_definition: (definition: Any) -> Any

    @invariant AtomicDefinitionBuild
        -- A complete workflow definition is validated before any authoring
        -- state changes. An invalid definition leaves no partial workflow.

    @invariant DeterministicDefinitionIdentity
        -- Rebuilding an unchanged named definition preserves workflow identity
        -- and produces no effective authoring changes. Definition equality uses
        -- the effective blackboard schemas after resolving referenced schemas
        -- recursively: changing any referenced schema rebuilds the workflow,
        -- while changing an unrelated schema does not. A build captures the
        -- resolved schemas so later registry changes cannot alter that build.

    @invariant ActionableSchemaSpecificityFailure
        -- A definition containing an unconstrained blackboard type is rejected
        -- with feedback that identifies the offending key and schema path, and
        -- directs the consumer to use the most specific schema that expresses
        -- its intent.

    @invariant ResearcherConfigurationSurvivesRoundTrip
        -- Exporting, rendering as public DSL, evaluating, or importing a
        -- researcher definition preserves every behavior-affecting public
        -- configuration field exactly. Tool contracts, consumer tool gates,
        -- browser tools, ontology context, and execution options never
        -- disappear or widen permissions at a serialization boundary.
}

contract ExecutionEventStream {
    subscribe: (execution_identifier: String, include_values: Boolean) -> Any
    next_envelope: (subscription: Any) -> StreamEnvelope
    close: (execution_identifier: String) -> Any

    @invariant MonotonicSequence
        -- Envelope sequence numbers strictly increase within one subscription;
        -- a gap explicitly indicates that ephemeral events were lost.

    @invariant SubscriberScopePrecedesBackpressure
        -- When a subscriber narrows its observation scope, unrelated events are
        -- excluded before they consume bounded delivery capacity or affect that
        -- subscriber's accepted, retried, failed or dropped accounting.

    @invariant StalledSubscriberRemainsBounded
        -- A subscriber that stops consuming cannot exceed its configured
        -- delivery capacity or delay workflow execution. Older ephemeral
        -- envelopes may be discarded, but the terminal stream closure remains
        -- the newest observable envelope.

    @invariant DurableRecovery
        -- Every durable fact represented by the ephemeral stream remains
        -- recoverable from the execution record and its lineage.
}

contract ExecutionDurability {
    classify_node: (node: WorkflowNode) -> String
    evaluate_ephemeral_chain: (execution: WorkflowExecution, node: WorkflowNode) -> Any

    @invariant DurableBoundariesRemainIndependent
        -- Model calls, tool or other external effects, delegation, authorization
        -- decisions, retry attempts, cancellation, timeout, blocking, partial
        -- outcomes and terminal workflow outcomes each leave independently
        -- durable evidence before execution advances beyond that boundary.

    @invariant EphemeralEvaluationIsNarrow
        -- Only built-in static conditions, deterministic routing, sequence or
        -- fallback advancement, and status propagation derived from completed
        -- children may be evaluated ephemerally. Parallel and map-each
        -- coordination, model-backed conditions, delegates, researcher nodes,
        -- and consumer-supplied code are not implicitly pure and remain durable.

    @invariant EphemeralInputsAreReplayable
        -- Ephemeral evaluation reads only the immutable workflow version and
        -- blackboard values already present at the preceding durable boundary.
        -- It does not read time, randomness, ambient mutable state or an
        -- unversioned implementation, and it cannot perform an external effect.

    @invariant BoundaryCommitIsUnambiguous
        -- Advancing through an ephemeral chain produces one unambiguous durable
        -- frontier before the next effectful or nondeterministic operation may
        -- begin. Blackboard changes needed by that operation, its stable attempt
        -- identity, and the frontier become durable together.

    @invariant RecoverableCheckpointPreservesMeaning
        -- ORC may checkpoint a completed subtree independently when doing so
        -- materially bounds deterministic replay or preserves coordination
        -- state. A checkpoint is authoritative recovery state, not merely
        -- telemetry.

    @invariant BatchedTracePreservesObservability
        -- A durable boundary may summarize the ordered ephemeral evaluations
        -- since the preceding boundary. Inspection distinguishes such summaries
        -- from independently durable node executions without presenting either
        -- as the other.

    @invariant TraceRefreshNeverRegresses
        -- Each execution publishes exactly one durable trace-creation fact.
        -- Reassembly may publish a distinct revision fact only when it adds
        -- durable source evidence beyond the canonical trace. A delayed, stale
        -- or duplicate publication adds no fact; a newer revision never removes
        -- evidence or changes the canonical order of retained executions.
}

contract ExecutionRecovery {
    resume: (execution: WorkflowExecution) -> Any

    @invariant StableExecutionIdentity
        -- Recovery continues the abandoned execution and node identities; it
        -- does not create a replacement run for unfinished frontier work.

    @invariant CompletedWorkIsNotRepeated
        -- Durable completion evidence is authoritative. Recovery reconstructs
        -- the last durable frontier, deterministically re-evaluates any lost
        -- ephemeral chain, and does not repeat a completed durable effect.

    @invariant IdempotentResume
        -- Repeated recovery requests converge on the same frontier and do not
        -- duplicate resumptions, completions, or externally visible effects.
}

contract CheckpointedResearcherExecution {
    execute_quantum: (execution: WorkflowExecution, node: WorkflowNode) -> Any
    resume_campaign: (execution: WorkflowExecution, node: WorkflowNode) -> Any
    inspect_iterations: (execution: WorkflowExecution, node: WorkflowNode) -> Any

    @invariant ExplicitOptInPreservesCompatibility
        -- Checkpointed execution applies only when the researcher explicitly
        -- enables it. Researchers without that option retain their existing
        -- single-invocation behavior, configuration meaning and result shape.

    @invariant BoundedQuantumYieldsDurably
        -- A work quantum completes at most its configured number of Phase-1
        -- iterations, one by default. Every completed iteration is checkpointed
        -- before a non-terminal campaign yields running. A larger quantum may
        -- reduce yields but never reduces checkpoint frequency.

    @invariant ResearcherResumesInPlace
        -- A yielded researcher resumes at its durable node frontier within the
        -- same workflow execution. Completed ancestors and siblings are not
        -- re-executed merely because the researcher requires another quantum.

    @invariant ExternalBoundariesAdvanceTheFrontier
        -- Provider responses, inline tool outcomes and generated child-tree
        -- outcomes each become durable before execution advances beyond that
        -- external boundary. The iteration checkpoint additionally captures
        -- ordered history, reasoning, sandbox state and metadata, accumulated
        -- usage and timing, child lineage, and remaining budgets.

    @invariant StableLogicalActionsPreventDuplicateWork
        -- Every provider call, inline tool call and generated child tree has a
        -- stable logical action identity established before dispatch. Duplicate
        -- delivery, retick and recovery observe a completed action rather than
        -- dispatching it again.

    @invariant CheckpointSafeToolsShareIdempotencyKeys
        -- A checkpointed researcher may invoke an effectful inline tool only
        -- when its bound contract explicitly declares checkpoint safety. ORC
        -- supplies that logical action's stable idempotency key through the tool
        -- execution context on every attempt; the tool is responsible for
        -- deduplicating the external effect. A tool that does not declare this
        -- capability is rejected before its effect begins.

    @invariant CompletedChildrenAreIncorporatedOnce
        -- A generated child receives stable logical action and child execution
        -- identities before dispatch. A durable success, partial or failure
        -- outcome is incorporated into the parent researcher exactly once,
        -- including when the process stops after child completion but before
        -- parent incorporation. Such a child is never replaced or rerun.

    @invariant IncompleteChildrenRetainLogicalIdentity
        -- A timed-out or cancelled generated child may receive another attempt
        -- only under the same logical action identity and within the iteration's
        -- retry allowance. Each attempt remains separately traceable.

    @invariant DurableSandboxValuesPreserveMeaning
        -- Checkpointed sandbox variables use the canonical durable value policy
        -- or an explicitly registered codec and retain creation and update
        -- metadata. Unsupported runtime values fail the iteration checkpoint
        -- explicitly; they are never silently dropped or stringified.

    @invariant TimeoutScopesRemainIndependent
        -- Provider-call, iteration, generated-child, researcher-campaign and
        -- enclosing-workflow deadlines are independently configured and
        -- evidenced. Each operation is bounded by the shortest applicable
        -- remaining deadline.

    @invariant CampaignDeadlineSurvivesRecovery
        -- A checkpointed campaign records one absolute campaign deadline when
        -- it starts. Yield, retick and process restart do not reset the
        -- deadline or any accumulated usage and timing budget.

    @invariant TimedOutIterationRetriesFromCheckpoint
        -- An iteration timeout preserves every preceding completed iteration
        -- and yields a retry of the same iteration from the last checkpoint,
        -- retaining its stable logical action identities. Exhausting the
        -- configured iteration-attempt limit terminates the campaign as timeout.

    @invariant BlockedChildPreservesPriorProgress
        -- A blocked generated child truthfully blocks the parent researcher and
        -- preserves all checkpoints completed before the blocked iteration.
        -- Blocking is a terminal workflow outcome under the ordinary ORC
        -- contract; it does not silently restart the child or campaign.

    @invariant CancellationIsTerminalForRecovery
        -- Cancelling the parent workflow cancels the campaign and its active
        -- child. Existing checkpoints remain inspectable, but neither automatic
        -- nor explicit recovery resumes a cancelled campaign.

    @invariant ResumeOwnershipIsFenced
        -- At most one worker owns a researcher frontier attempt at a time.
        -- Concurrent reticks, duplicate resume requests and automatic recovery
        -- converge without duplicating provider, tool or child work.

    @invariant ActiveCampaignsResumeFromRecoveryScan
        -- After process restart, the ordinary ORC recovery scan rediscovers
        -- every checkpointed campaign whose parent execution remains active and
        -- resumes it without resubmitting the workflow. Repeated recovery scans
        -- and explicit resume remain safe and idempotent.

    @invariant IterationTraceIsDurableAndOrdered
        -- Trace inspection exposes every completed researcher iteration even
        -- when a later iteration fails or times out. Each ordered iteration
        -- includes generated reasoning and code, provider latency and usage,
        -- sandbox result or error, variable changes, checkpoint/yield/resume
        -- evidence, and links to generated child traces and outcomes without
        -- duplicating the child trace itself.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ExecutionMode { draft | published }

enum NodeKind {
    llm | code | tool | condition | llm_condition | sequence | fallback |
    parallel | map_each | repl_researcher | delegate
}

enum ExecutionStatus {
    running | success | failure | partial | timeout | blocked | cancelled
}

enum NodeExecutionStatus {
    running | success | failure | partial | timeout | blocked | skipped
}

enum DelegateInvocationStatus { running | success | failure | timeout | cancelled }

enum StructuredFailureKind {
    transport_failure | missing_forced_tool_call | tool_call_parsing_failed |
    schema_validation_failed | empty_provider_response
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Workflow {
    name: String
    execution_mode: ExecutionMode
    draft_dirty: Boolean
    published_version_number: Integer?
    content_fingerprint: String?

    nodes: WorkflowNode with workflow = this
    keys: BlackboardKey with workflow = this
    versions: WorkflowVersion with workflow = this
    executions: WorkflowExecution with workflow = this
}

entity BlackboardKey {
    workflow: Workflow
    name: String
    schema: DataSchema
    draft_value: BlackboardValue?
    version: Integer
}

entity WorkflowNode {
    workflow: Workflow
    name: String
    kind: NodeKind
    parent: WorkflowNode?
    child_order: Integer
    reads: Set<BlackboardKey>
    writes: Set<BlackboardKey>
    configuration: NodeConfiguration
    retry_policy: RetryPolicy?

    children: WorkflowNode with parent = this
}

entity WorkflowVersion {
    workflow: Workflow
    number: Integer
    description: String?
    published_at: Timestamp
    definition: Any
}

entity DraftStash {
    workflow: Workflow
    stashed_at: Timestamp
    definition: Any
}

entity WorkflowExecution {
    workflow: Workflow
    status: ExecutionStatus
    started_at: Timestamp
    completed_at: Timestamp?
    duration: Duration?
    version_number: Integer?
    parent: WorkflowExecution?
    correlation_identifier: String
    options: ExecutionOptions
    error: String?

    transitions status {
        running -> success
        running -> failure
        running -> partial
        running -> timeout
        running -> blocked
        running -> cancelled
        terminal: success, failure, partial, timeout, blocked, cancelled
    }

    node_executions: NodeExecution with execution = this
    values: ExecutionValue with execution = this
    child_executions: WorkflowExecution with parent = this
}

entity NodeExecution {
    execution: WorkflowExecution
    node: WorkflowNode
    trace_instance_identifier: String
    parent_node_execution: NodeExecution?
    status: NodeExecutionStatus
    started_at: Timestamp
    completed_at: Timestamp?
    error: String?
    usage: Usage?
    iteration_index: Integer?
    rejected_outputs: Any?
    structured_failure_kind: StructuredFailureKind?
    provider_failure_evidence: ProviderFailureEvidence?

    transitions status {
        running -> success
        running -> failure
        running -> partial
        running -> timeout
        running -> blocked
        running -> skipped
        terminal: success, failure, partial, timeout, blocked, skipped
    }

    writes: ExecutionValue with node_execution = this
    delegate_invocation: DelegateInvocation with node_execution = this
}

entity DelegateInvocation {
    node_execution: NodeExecution
    child_execution: WorkflowExecution
    invocation_ordinal: Integer
    status: DelegateInvocationStatus
    configured_timeout: Duration?
    configured_maximum_ticks: Integer?
    consumed_ticks: Integer
    terminal_reason: String?

    transitions status {
        running -> success
        running -> failure
        running -> timeout
        running -> cancelled
        terminal: success, failure, timeout, cancelled
    }
}

entity ExecutionValue {
    execution: WorkflowExecution
    node_execution: NodeExecution?
    key: BlackboardKey
    value: BlackboardValue
    written_at: Timestamp
    iteration_index: Integer?
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RegisterWorkflow {
    when: RegisterWorkflow(consumer, name)
    requires: not exists Workflow{name: name}

    ensures: Workflow.created(
        name: name,
        execution_mode: draft,
        draft_dirty: false,
        published_version_number: null,
        content_fingerprint: null
    )
}

rule AddWorkflowNode {
    when: AddWorkflowNode(consumer, workflow, name, kind, parent, child_order, reads, writes, configuration)
    requires: reads.all(k => k.workflow = workflow)
    requires: writes.all(k => k.workflow = workflow)
    requires: parent = null or parent.workflow = workflow

    ensures: WorkflowNode.created(
        workflow: workflow,
        name: name,
        kind: kind,
        parent: parent,
        child_order: child_order,
        reads: reads,
        writes: writes,
        configuration: configuration,
        retry_policy: null
    )
    ensures: workflow.draft_dirty = true
}

rule DeclareBlackboardKey {
    when: DeclareBlackboardKey(consumer, workflow, name, schema)
    requires: not exists BlackboardKey{workflow: workflow, name: name}
    requires: schema.is_specific

    ensures: BlackboardKey.created(
        workflow: workflow,
        name: name,
        schema: schema,
        draft_value: null,
        version: 1
    )
    ensures: workflow.draft_dirty = true

    @guidance
        -- Unconstrained types are forbidden at every depth of a blackboard
        -- schema, including inside maps, collections, alternatives and tuples.
}

rule PublishWorkflow {
    when: PublishWorkflow(consumer, workflow, description)
    let next_number = (workflow.published_version_number ?? 0) + 1

    ensures: WorkflowVersion.created(
        workflow: workflow,
        number: next_number,
        description: description,
        published_at: now,
        definition: snapshot(workflow)
    )
    ensures: workflow.published_version_number = next_number
    ensures: workflow.draft_dirty = false
}

rule RevertDraftToVersion {
    when: RevertDraftToVersion(consumer, workflow, version)
    requires: version.workflow = workflow
    requires: definition_has_specific_blackboard_schemas(version.definition)

    ensures: DraftStash.created(
        workflow: workflow,
        stashed_at: now,
        definition: snapshot(workflow)
    )
    ensures: ApplyVersionDefinition(workflow: workflow, definition: version.definition)
    ensures: workflow.draft_dirty = true
}

rule RestoreDraftStash {
    when: RestoreDraftStash(consumer, workflow, stash)
    requires: stash.workflow = workflow
    requires: definition_has_specific_blackboard_schemas(stash.definition)

    ensures: ApplyVersionDefinition(workflow: workflow, definition: stash.definition)
    ensures: workflow.draft_dirty = true
    ensures: not exists stash
}

rule StartWorkflowExecution {
    when: RunWorkflow(consumer, workflow, inputs, options)
    requires: inputs_valid_for(workflow, inputs)
    requires: options.version_number = null or exists WorkflowVersion{workflow: workflow, number: options.version_number}

    ensures:
        let execution = WorkflowExecution.created(
            workflow: workflow,
            status: running,
            started_at: now,
            completed_at: null,
            duration: null,
            version_number: selected_version(workflow, options),
            parent: null,
            correlation_identifier: options.correlation_identifier ?? new_correlation_identifier(),
            options: options,
            error: null
        )
        for input in input_entries(inputs):
            ExecutionValue.created(
                execution: execution,
                node_execution: null,
                key: input.key,
                value: input.value,
                written_at: now,
                iteration_index: null
            )
        ExecuteRoot(execution: execution)
}

rule StartNodeExecution {
    when: ExecuteNode(execution, node, iteration_index)
    requires: execution.status = running
    requires: node.workflow = execution.workflow
    requires: classify_node(node) != "ephemeral_evaluation"

    ensures: NodeExecution.created(
        execution: execution,
        node: node,
        trace_instance_identifier: new_trace_instance_identifier(),
        parent_node_execution: current_parent_node_execution(execution),
        status: running,
        started_at: now,
        completed_at: null,
        error: null,
        usage: null,
        iteration_index: iteration_index,
        rejected_outputs: null
    )
}

rule EvaluateEphemeralNode {
    when: ExecuteNode(execution, node, iteration_index)
    requires: execution.status = running
    requires: node.workflow = execution.workflow
    requires: classify_node(node) = "ephemeral_evaluation"

    ensures: EphemeralNodeEvaluated(
        execution: execution,
        node: node,
        iteration_index: iteration_index,
        result: evaluate_ephemeral_chain(execution, node)
    )

    @guidance
        -- One evaluation may synchronously traverse consecutive ephemeral nodes.
        -- It stops before any durable boundary and may be represented by one
        -- ordered trace summary attached to that boundary.
}

rule NodeSucceeds {
    when: NodeCompletes(node_execution, outputs, usage)
    requires: node_execution.status = running
    requires: outputs_valid_for(node_execution.node, outputs)

    ensures: node_execution.status = success
    ensures: node_execution.completed_at = now
    ensures: node_execution.usage = usage
    ensures:
        for output in output_entries(outputs):
            ExecutionValue.created(
                execution: node_execution.execution,
                node_execution: node_execution,
                key: output.key,
                value: output.value,
                written_at: now,
                iteration_index: node_execution.iteration_index
            )
}

rule NodeFails {
    when: NodeFails(node_execution, error)
    requires: node_execution.status = running

    ensures: node_execution.status = failure
    ensures: node_execution.completed_at = now
    ensures: node_execution.error = error
    ensures: node_execution.rejected_outputs = rejected_outputs_for(node_execution)
    ensures: node_execution.structured_failure_kind = structured_failure_kind_for(node_execution)
    ensures: node_execution.provider_failure_evidence = provider_failure_evidence_for(node_execution)

    @guidance
        -- Provider-originated values are decoded through each declared data
        -- schema before validation. JSON numeric representations that have the
        -- same schema meaning are canonicalized, while strings are not treated
        -- as numbers. Rejected values remain inspection evidence and never
        -- become execution values or blackboard state.
}

rule NodePartiallySucceeds {
    when: MapEachPartiallyCompletes(node_execution, aligned_outputs, failure_details)
    requires: node_execution.status = running
    requires: node_execution.node.kind = map_each

    ensures: node_execution.status = partial
    ensures: node_execution.completed_at = now
    ensures: PartialOutcomeRecorded(node_execution: node_execution, outputs: aligned_outputs, failures: failure_details)
}

rule NodeTimesOut {
    when: NodeBudgetExpires(node_execution)
    requires: node_execution.status = running

    ensures: node_execution.status = timeout
    ensures: node_execution.completed_at = now
}

rule NodeBlocks {
    when: LeafRequestsBlock(node_execution, opaque_payload)
    requires: node_execution.status = running

    ensures: node_execution.status = blocked
    ensures: node_execution.completed_at = now
    ensures: ExecutionBlocked(execution: node_execution.execution, payload: opaque_payload)
}

rule NodeSkipped {
    when: ControlFlowSkipsNode(node_execution)
    requires: node_execution.status = running

    ensures: node_execution.status = skipped
    ensures: node_execution.completed_at = now
}

rule WorkflowSucceeds {
    when: WorkflowTreeCompletes(execution, outputs)
    requires: execution.status = running
    requires: all_required_outputs_present(execution, outputs)

    ensures: execution.status = success
    ensures: execution.completed_at = now
    ensures: execution.duration = now - execution.started_at
}

rule WorkflowFails {
    when: WorkflowTreeFails(execution, error)
    requires: execution.status = running

    ensures: execution.status = failure
    ensures: execution.completed_at = now
    ensures: execution.duration = now - execution.started_at
    ensures: execution.error = error
}

rule WorkflowPartiallySucceeds {
    when: WorkflowTreePartiallyCompletes(execution, summary)
    requires: execution.status = running

    ensures: execution.status = partial
    ensures: execution.completed_at = now
    ensures: execution.duration = now - execution.started_at
    ensures: PartialOutcomeRecorded(execution: execution, summary: summary)
}

rule WorkflowTimesOut {
    when: WorkflowBudgetExpires(execution)
    requires: execution.status = running

    ensures: execution.status = timeout
    ensures: execution.completed_at = now
    ensures: execution.duration = now - execution.started_at
}

rule WorkflowBlocks {
    when: ExecutionBlocked(execution, payload)
    requires: execution.status = running

    ensures: execution.status = blocked
    ensures: execution.completed_at = now
    ensures: execution.duration = now - execution.started_at
    ensures: BlockingPayloadReturned(execution: execution, payload: payload)
}

rule CancelWorkflowExecution {
    when: CancelWorkflowExecution(consumer, execution)
    requires: execution.status = running

    ensures: execution.status = cancelled
    ensures: execution.completed_at = now
    ensures: execution.duration = now - execution.started_at
    ensures:
        for child in execution.child_executions where status = running:
            CancelWorkflowExecution(consumer: consumer, execution: child)
}

rule ResumeWorkflowExecution {
    when: ResumeWorkflowExecution(consumer, execution)
    requires: execution.status = running

    ensures: RecoveryFrontierReconstructed(execution: execution)
}

rule RetickRunningWorkflowFrontier {
    when: NodeRemainsRunning(node_execution)
    requires: node_execution.status = running
    requires: node_execution.execution.status = running
    requires: execution_tick_budget_remaining(node_execution.execution)

    ensures: NextWorkflowIterationRequested(
        execution: node_execution.execution,
        after_iteration: node_execution.iteration_index
    )

    @guidance
        -- A node reached after a completed delegate participates in the current
        -- parent iteration. Historical delegate observations from an earlier
        -- iteration cannot suppress this running frontier or its next tick.
}

rule DelegateToWorkflow {
    when: ExecuteDelegateNode(node_execution, target_workflow, mapped_inputs, options)
    requires: node_execution.status = running
    requires: node_execution.node.kind = delegate
    requires: inputs_valid_for(target_workflow, mapped_inputs)
    requires: not exists node_execution.delegate_invocation

    ensures:
        let child = WorkflowExecution.created(
            workflow: target_workflow,
            status: running,
            started_at: now,
            completed_at: null,
            duration: null,
            version_number: selected_version(target_workflow, options),
            parent: node_execution.execution,
            correlation_identifier: node_execution.execution.correlation_identifier,
            options: options,
            error: null
        )
        DelegateInvocation.created(
            node_execution: node_execution,
            child_execution: child,
            invocation_ordinal: node_execution.iteration_index ?? 1,
            status: running
        )
}

rule ObserveRunningDelegate {
    when: ExecuteDelegateNode(node_execution, target_workflow, mapped_inputs, options)
    requires: node_execution.status = running
    requires: node_execution.node.kind = delegate
    requires: exists node_execution.delegate_invocation
    requires: node_execution.delegate_invocation.status = running

    ensures: ExistingDelegateChildObserved(
        node_execution: node_execution,
        child_execution: node_execution.delegate_invocation.child_execution
    )
}

rule ReplResearcherEmitsTree {
    when: ResearchIterationEmitsTree(node_execution, generated_tree)
    requires: node_execution.status = running
    requires: node_execution.node.kind = repl_researcher
    requires: generated_tree_valid(generated_tree)

    ensures: GeneratedTreeExecutionRequested(
        parent_node_execution: node_execution,
        tree: generated_tree,
        remaining_budget: remaining_budget(node_execution)
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant UniqueWorkflowName {
    for a in Workflows:
        for b in Workflows:
            a != b implies a.name != b.name
}

invariant UniqueVersionNumberPerWorkflow {
    for a in WorkflowVersions:
        for b in WorkflowVersions:
            a != b and a.workflow = b.workflow implies a.number != b.number
}

invariant NodeContractsUseOwnBlackboard {
    for node in WorkflowNodes:
        node.reads.all(k => k.workflow = node.workflow)
        and node.writes.all(k => k.workflow = node.workflow)
}

invariant ExecutionValuesBelongToWorkflow {
    for value in ExecutionValues:
        value.key.workflow = value.execution.workflow
}

invariant CorrelationIdentifiersAreUUIDs {
    for execution in WorkflowExecutions:
        is_uuid(execution.correlation_identifier)
}

invariant DelegateBudgetsArePositiveAndBounded {
    for invocation in DelegateInvocations:
        (invocation.configured_timeout = null
         or invocation.configured_timeout > 0.seconds)
        and (invocation.configured_maximum_ticks = null
         or invocation.configured_maximum_ticks > 0)
        and invocation.consumed_ticks >= 0
        and (invocation.configured_maximum_ticks = null
             or invocation.consumed_ticks <= invocation.configured_maximum_ticks)
}

invariant TraceInstanceIdentifiersAreUnique {
    for a in NodeExecutions:
        for b in NodeExecutions:
            a != b implies a.trace_instance_identifier != b.trace_instance_identifier
}

invariant DescendantsRetainOperationCorrelation {
    for execution in WorkflowExecutions:
        execution.parent != null implies execution.correlation_identifier = execution.parent.correlation_identifier
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface WorkflowAuthoring {
    facing consumer: WorkflowConsumer

    provides:
        RegisterWorkflow(consumer, name)
        AddWorkflowNode(consumer, workflow, name, kind, parent, child_order, reads, writes, configuration)
        DeclareBlackboardKey(consumer, workflow, name, schema)
        PublishWorkflow(consumer, workflow, description)
        RevertDraftToVersion(consumer, workflow, version)
        RestoreDraftStash(consumer, workflow, stash)

    contracts:
        fulfils WorkflowDefinitionConstruction
}

surface WorkflowExecutionAccess {
    facing consumer: WorkflowConsumer
    context workflow: Workflow

    exposes:
        workflow.name
        workflow.execution_mode
        workflow.published_version_number
        workflow.nodes
        workflow.keys
        workflow.versions
        workflow.executions

    provides:
        RunWorkflow(consumer, workflow, inputs, options)
        CancelWorkflowExecution(consumer, execution)
        ResumeWorkflowExecution(consumer, execution)

    contracts:
        fulfils ExecutionEventStream
        fulfils ExecutionDurability
        fulfils ExecutionRecovery
        fulfils CheckpointedResearcherExecution
        demands LeafExecutor

    @guarantee IsolatedBlackboard
        -- Each run begins from its supplied inputs and cannot mutate draft
        -- blackboard values or another execution's values.

    @guarantee OpaqueBlockingPayload
        -- ORC propagates a leaf's blocking payload without interpreting it.

    @guarantee ConfigurableCanonicalValuePlacement
        -- A deployment selects one canonical value placement policy without
        -- ORC making per-value size or shape decisions. Values remain
        -- recoverable through the same execution and trace-detail surfaces.

    @guarantee ReferencedValueIntegrity
        -- If canonical bytes are stored outside the event record, ORC rejects
        -- missing or corrupted bytes rather than returning a partial value.

    @guarantee ExactNodeExecutionInspection
        -- Each independently durable node execution has a unique trace instance
        -- identifier, and its inputs, accepted outputs, and schema-rejected
        -- outputs can be inspected without ambiguity when the same workflow node
        -- runs repeatedly or concurrently. Ephemeral evaluations are identified
        -- separately and retain their ordered summarized trace details.

    @guarantee SingleExecutionDeadline
        -- The execution option timeout is the authoritative wall-clock budget
        -- for the workflow and its in-flight leaf work. Each provider request
        -- is bounded by the lesser of its configured request timeout and the
        -- execution time remaining when the request begins.

    @guarantee SharedLlmCallBudget
        -- An execution's LLM-call budget counts every provider invocation in
        -- its trace family, including recursive researcher iterations, inline
        -- researcher primitives and descendant generated-tree leaves. Once
        -- exhausted, no branch can make a further provider call.

    @guarantee PartialTimeoutEvidence
        -- A workflow timeout preserves every independently durable node start and
        -- completion plus each committed ephemeral trace summary. A durable node
        -- that started but did not complete is identified as the active timed-out
        -- node together with its provider attempt, node attempt, configured
        -- limits, execution budget state, and preceding durable frontier.

    @guarantee ActualExecutionTiming
        -- Every terminal execution preserves the durable instant at which it
        -- began, records the terminal instant separately, and reports a
        -- duration equal to the elapsed time between those instants within the
        -- precision of the public duration representation. Unfinished durable
        -- nodes retain their start and use the workflow timeout instant only as
        -- their completion; summarized ephemeral steps do not claim independent
        -- durable timing.

    @guarantee ChronologicalTraceQueries
        -- Trace lists, status filters, time filters, families and performance
        -- views compare timestamp values chronologically, independent of an
        -- input timestamp's UTC offset spelling. Limits are applied only after
        -- chronological ordering, with stable trace identity as a tie-breaker.

    @guarantee CanonicalTraceTimestamps
        -- Every trace status is exposed with one canonical UTC timestamp
        -- representation, including records reconstructed by replay from
        -- historically equivalent offset timestamp representations. A stored
        -- timeout remains directly retrievable by its trace identity.

    @guarantee TerminalCancellationFence
        -- Concurrent cancellation attempts converge on at most one durable
        -- cancellation terminal for an execution. Once an execution or any
        -- ancestor is cancelled or times out, work already in flight cannot
        -- create execution values or node/tree completions for that terminal
        -- execution.

    @guarantee StableDelegateLifecycle
        -- One logical delegate invocation durably identifies exactly one child
        -- execution. Duplicate delivery and process recovery observe or resume
        -- that child rather than creating another. Reaching the same delegate in
        -- a later parent iteration after its prior child terminated creates a new
        -- invocation with current inputs and distinct trace lineage. Its terminal
        -- result and outputs flow back only to its originating parent iteration;
        -- cancellation and lineage remain consistent across nested delegates.

    @guarantee ConsistentCodeFunctionResolution
        -- A public application function that is loaded before its code node runs
        -- resolves identically for synchronous, background, resumed and delegated
        -- execution, including workflows registered after background processing starts.
        -- A genuinely absent function terminates the node with traceable evidence.

    @guarantee DurableDelegateCompletionDelivery
        -- A terminal delegated child durably makes its parent runnable. Exactly
        -- one parent-node completion consumes the child's success outputs or
        -- structured failure, independent of process-local observers, duplicate
        -- wakes, parent re-ticks and repeated process recovery.

    @guarantee DurableRunningFrontierRetick
        -- When a condition or code frontier deliberately remains running and
        -- execution budget remains, the workflow durably requests its next
        -- root iteration. A previously completed delegate cannot make that
        -- transition silent, including after recovery or duplicate delivery.
}
