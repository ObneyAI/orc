-- allium: 3
-- gepa.allium
--
-- Scope: offline evolution of static ORC LLM-node instructions through
-- reflective mutation, Pareto selection, subsample gating, and crossover.
-- Includes: event-sourced runs, persisted train/validation data, metric budget,
-- score-plus-feedback evaluation, candidate ancestry, round-robin component
-- selection, per-example Pareto diversity, cross-run inheritance, and terminal
-- completion/failure.
-- Excludes: Grain processor mechanics, Clojure/Python representation details,
-- model-provider transport mechanics, ORC execution internals, and
-- ontology/RLM tree design. Durable model-call identity and usage are included.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity OptimizationConsumer {}

external entity OrcWorkflow {
    name: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value DatasetExample {
    inputs: Any
    expected: Any?
}

value ModelProvenance {
    call_identifier: String
    provider: String?
    model: String
    prompt_tokens: Integer?
    completion_tokens: Integer?
    total_tokens: Integer?
    cost: Decimal?
}

value OptimizationConfiguration {
    maximum_metric_calls: Integer
    reflection_minibatch_size: Integer
    reflection_model: String
    reflection_options: Any?
    metric_max_attempts: Integer?
    metric_timeout_ms: Integer?
    use_merge: Boolean
    validation_overlap_floor: Integer
    skip_perfect_score: Boolean
    inherit_from_previous: Boolean
    reflection_prompt_template: Any?
    maximum_reflection_tokens: Integer?
}

value MetricResult {
    score: Decimal
    feedback: String?
}

value ReflectiveExample {
    inputs: Any
    generated_outputs: Any
    feedback: String
}

value CandidateEvaluation {
    scores: List<Decimal>
    feedback: List<String?>
    aggregate_score: Decimal
    metric_calls: Integer
    trace_identifiers: List<String>
}

value InstructionProposal {
    instruction: String
    raw_response: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract CandidateMetric {
    evaluate: (example: DatasetExample, actual_output: Any) -> MetricResult

    @invariant BoundedScore
        -- Every metric score lies from zero through one.

    @invariant CanonicalMetricFields
        -- Built-in metrics accept exact field names and their string/keyword
        -- equivalents without dropping namespaces. Exact presence wins, including
        -- nil. Default grading uses named answer/output/result fields; unrelated
        -- fields cannot replace a missing answer in a multi-field output.

    @invariant DiagnosticPreservation
        -- When a metric supplies feedback, the exact diagnosis remains attached
        -- to that example through reflection and candidate evaluation.

    @guidance
        -- Structural metrics may omit feedback; judge metrics should aggregate
        -- dimension feedback from weakest score to strongest.
}

contract ReflectiveInstructionProposer {
    build_dataset: (minibatch: List<DatasetExample>, parent_evaluation: CandidateEvaluation) -> List<ReflectiveExample>
    propose: (current_instruction: String, examples: List<ReflectiveExample>) -> InstructionProposal

    @invariant PersistedReflectionOptions
        -- Consumer-supplied reflection generation settings survive restart and
        -- reach proposal requests while preserving model selection and the
        -- structured response contract. No fixed temperature is imposed.

    @invariant ReflectionFromTheParentsTrainingMinibatch
        -- A mutation round draws a minibatch from the training set before any
        -- reflection, evaluates the parent whose instruction will be rewritten
        -- on that minibatch, and builds its reflective examples from that
        -- evaluation alone. Each reflective example's inputs, generated outputs
        -- and feedback belong to one and the same training example, whatever
        -- the sizes or order of the training and validation sets. The
        -- validation set scores candidates and keeps the frontier; it never
        -- feeds reflection. An example whose evaluation failed or is unknown
        -- is never a reflective example.

    @invariant FailureFocusedReflection
        -- Reflective examples preferentially expose the minibatch examples where
        -- the parent scores below perfect, including inputs, outputs, and feedback.

    @invariant OneComponentMutation
        -- A mutation changes the selected named instruction component while
        -- retaining all other candidate instructions.

    @invariant RoundRobinComponents
        -- Each candidate rotates through its named instruction components in a
        -- stable order. The rotation advances once for every round on that
        -- candidate that reaches reflection; a round skipped because the parent
        -- is perfect on its minibatch does not advance it, and a repeated
        -- request for the same round chooses the same component. A new
        -- candidate continues from the furthest rotation among its parents.

    @invariant PersistedReflectionPromptTemplate
        -- A consumer may supply one reflection prompt template for every
        -- component, or one per named component. Each template carries both the
        -- current-instruction and the examples placeholders; a template missing
        -- either is refused when the optimization starts, before any evaluation.
        -- The template survives restart and is used for every proposal for its
        -- component; a component without one uses the default template.

    @invariant ReflectionBudgetCheckedBeforeEachProposal
        -- When a reflection token budget is set, no proposer call starts once
        -- the recorded reflection tokens reach it; one call may take the total
        -- past the budget by its own usage. A completed proposer call reused on
        -- resume is not counted again.

    @invariant EveryModelInstructionIsAComponent
        -- Every model leaf, model decision and model-backed condition
        -- contributes its instruction as a named component, and when a
        -- candidate is evaluated that node uses the candidate's instruction in
        -- place of its authored one. Researcher instructions are not
        -- components.
}

contract ParetoPopulationSelection {
    non_dominated: (candidates: Set<InstructionCandidate>) -> Set<InstructionCandidate>
    select_for_mutation: (candidates: Set<InstructionCandidate>) -> InstructionCandidate
    mergeable_pair: (candidates: Set<InstructionCandidate>) -> Any

    @invariant PerExampleDiversity
        -- The frontier retains every candidate tied for the best score on each
        -- validation example, then removes programs dominated across examples.

    @invariant StrictMutationAcceptance
        -- A proposed mutation proceeds beyond its subsample only when its score
        -- sum is strictly greater than the parent's on the same examples: the
        -- training minibatch the parent was reflected on, compared with that
        -- same parent evaluation, which is reused rather than run again.

    @invariant CommonAncestorCrossover
        -- Merge candidates share an ancestor and contribute different improved
        -- components; an already-attempted pair is not retried.

    @invariant MergeAcceptance
        -- A merged candidate is accepted only when its validation performance is
        -- at least as strong as the better parent under the merge criterion.
}

contract DurableOptimizationLifecycle {
    resume: (optimization: OptimizationRun) -> Any
    apply_winner: (optimization: OptimizationRun, source_version: Integer) -> Any

    @invariant DurableModelEvidence
        -- Every completed proposer and task-model call records its resolved
        -- model, stable call identity, usage, any provider-reported cost, and
        -- associated optimization evidence before dependent frontier work
        -- proceeds.

    @invariant ResumeFromRecordedBoundary
        -- Recovery continues from the latest durable proposal or evaluation
        -- boundary, preserves the run and candidate identities, respects the
        -- remaining metric budget, and is safe to request repeatedly.

    @invariant ExclusiveEvaluationOwnership
        -- Concurrent deliveries of one evaluation share its task identities.
        -- Only the current owner may execute or complete unfinished work;
        -- losing ownership cannot authorize another tree or metric invocation.

    @invariant RecoverOriginalExecution
        -- Task identity and its associated workflow execution are durable before
        -- dispatch. Recovery reuses completed outputs and recovers the original
        -- unfinished execution rather than starting a replacement tree.

    @invariant AutomaticTaskRecovery
        -- Abandoned tasks are rediscovered periodically, including tasks whose
        -- workflow completed before their metric or aggregate was recorded.
        -- Healthy owners renew ownership; obsolete owners cannot finalize work.

    @invariant PreserveMetricIdentity
        -- Recovery uses the original metric identity, configuration and feedback
        -- contract. A missing custom registration requires visible recovery
        -- attention; it never silently substitutes the default metric.

    @invariant BoundedSafeMetricRecovery
        -- An interrupted metric may retry against the original workflow output
        -- only when declared safe to repeat, within its attempt, time and metric
        -- budgets. Unknown unsafe outcomes require explicit recovery attention.
        -- Default limits are three total attempts and five minutes per attempt;
        -- consumers may configure both. Built-in read-only judges are retry-safe.

    @invariant AttemptAccountingSurvivesRecovery
        -- Capacity is reserved atomically before work. Each initial evaluation
        -- and additional metric attempt is charged once before dispatch, including
        -- attempts with unknown outcomes. Reuse and aggregate publication do not
        -- charge again. Every public budget view agrees with durable accounting.
        -- Accounting never creates an optimization view when no optimization exists
        -- in the caller's tenant; absent views remain absent.

    @invariant CompleteComparisonsOnly
        -- An evaluation aggregate contains all required task outcomes. Pending,
        -- failed or unknown metric outcomes never become invented zero scores or
        -- incomplete comparisons. Budget exhaustion preserves completed evidence.
        -- Once admitted work is finished, exhausted capacity selects an existing
        -- fully evaluated winner or records failure if no such candidate exists.

    @invariant LegacyAccountingProvenance
        -- Completed historical aggregates retain their recorded expenditure.
        -- Unfinished historical tasks may be explicitly adopted with their source
        -- evidence, without charging already-covered work again. Unattributable
        -- history is reported rather than guessed; mixed runtime writers are not
        -- permitted while an optimization crosses the accounting boundary.

    @invariant ConflictedLedgerWritesRetry
        -- A task-ledger write refused because another writer changed the same
        -- stream first is retried with bounded, jittered backoff on every event
        -- store, however the store reports the conflict. A refusal the ledger
        -- decides itself is returned at once, not retried. When retries run out,
        -- the task is left at a recoverable boundary that resume continues once
        -- the task's lease lapses. A run never stalls with a task whose workflow
        -- completed and whose metric never started.

    @invariant InheritanceIsExplicitlyControlled
        -- A run inherits earlier candidates only when inheritance is allowed
        -- for it, and turning inheritance off when starting a run takes effect
        -- however the caller passes the option. A run that names one earlier
        -- optimization inherits only that optimization's candidates, even when
        -- inheritance is otherwise turned off; otherwise
        -- it inherits the best candidates of every completed run of the
        -- workflow.

    @invariant InheritedScoresOnlyForTheSameEvidence
        -- An inherited candidate reuses a recorded per-example score only for
        -- an example identical in content to the one scored, on the same
        -- workflow content and the same metric. Every other example is
        -- evaluated in this run and charged to its budget, and only those: a
        -- candidate whose validation set gained or changed examples reuses the
        -- scores of its unchanged examples and is charged one metric call for
        -- each new or changed example. A reused score is
        -- never moved to a different example by position, and an edited
        -- workflow or metric never reuses scores from before the edit. When a
        -- run inherits, its seed reuses the recorded scores of an identical
        -- instruction set from the runs it inherits from under the same rule.

    @invariant ContinuedRunsContinueTheMinibatchSchedule
        -- Training minibatches follow one deterministic schedule. A run that
        -- inherits candidates continues that schedule from the furthest point
        -- reached by the runs it inherits from, so it never repeats their
        -- minibatches in the same order. A run that inherits nothing starts the
        -- schedule from its beginning. A repeated or resumed request for the
        -- same round draws the same minibatch.

    @invariant OneMutationRoundAtATime
        -- A run has at most one undecided mutation round. A round is decided
        -- when its proposal is rejected, its parent is skipped as perfect, or
        -- its accepted proposal has a full validation evaluation. The first
        -- round opens only after every starting candidate of the run, its seed
        -- and every inherited candidate, has an evaluation.

    @invariant EveryOpenedRoundCanFinish
        -- A mutation round opens only when the remaining metric budget pays
        -- for its whole cycle: the parent's minibatch, the proposal's minibatch
        -- and a full validation evaluation. When it cannot, the run finishes as
        -- at budget exhaustion, so an accepted proposal is never left without
        -- its full evaluation for lack of budget.

    @invariant TerminalWinnerStable
        -- Completion waits for fully evaluated comparisons whose aggregates
        -- remain publishable. Terminal selection and aggregate publication
        -- arbitrate atomically, so later delivery cannot change the recorded
        -- winner or publish a new comparison into a terminal optimization.
        -- Competing completion and failure requests publish at most one terminal
        -- outcome; neither request may reopen or replace a terminal outcome.
        -- A budget-limited incomplete comparison does not prevent selecting
        -- an existing fully evaluated winner once admitted work has finished.

    @invariant ImmutableWinnerPublication
        -- Applying a completed winner requires the exact source workflow
        -- version, leaves that version unchanged, and publishes a distinct new
        -- version containing the winning named instructions.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum OptimizationStatus { running | completed | failed }

enum CandidateStatus {
    created | subsample_evaluated | evaluated | rejected
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity OptimizationRun {
    workflow: OrcWorkflow
    status: OptimizationStatus
    trainset: List<DatasetExample>
    validation_set: List<DatasetExample>
    configuration: OptimizationConfiguration
    metric_calls_used: Integer
    reflection_tokens_used: Integer
    started_at: Timestamp
    completed_at: Timestamp?
    failure_reason: String?
    inherited_from: OptimizationRun?

    full_round_cost: configuration.reflection_minibatch_size * 2 + validation_set.count
    can_afford_round: metric_calls_used + full_round_cost <= configuration.maximum_metric_calls

    transitions status {
        running -> completed
        running -> failed
        terminal: completed, failed
    }

    candidates: InstructionCandidate with optimization = this
    frontier_entries: ParetoEntry with optimization = this
    model_calls: ModelCallEvidence with optimization = this
}

entity ModelCallEvidence {
    optimization: OptimizationRun
    call_identifier: String
    role: String
    model_provenance: ModelProvenance
    trace_identifier: String?
    completed_at: Timestamp
}

entity InstructionCandidate {
    optimization: OptimizationRun
    status: CandidateStatus
    instructions: Any
    generation: Integer
    source_optimization: OptimizationRun?
    evaluation: CandidateEvaluation?
    subsample_evaluation: CandidateEvaluation?
    mutation_reason: String?

    transitions status {
        created -> evaluated
        created -> subsample_evaluated
        subsample_evaluated -> evaluated
        subsample_evaluated -> rejected
        terminal: evaluated, rejected
    }

    parents: CandidateParent with child = this
}

entity CandidateParent {
    child: InstructionCandidate
    parent: InstructionCandidate
}

entity ParetoEntry {
    optimization: OptimizationRun
    validation_index: Integer
    best_score: Decimal
    best_candidates: Set<InstructionCandidate>
}

entity MergeAttempt {
    optimization: OptimizationRun
    first_parent: InstructionCandidate
    second_parent: InstructionCandidate
    accepted: Boolean
    attempted_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule StartOptimization {
    when: StartOptimization(consumer, workflow, trainset, validation_set, configuration, inherited_from)
    requires: validation_set.count > 0
    requires: configuration.maximum_metric_calls > 0

    ensures: OptimizationRun.created(
        workflow: workflow,
        status: running,
        trainset: trainset,
        validation_set: validation_set,
        configuration: configuration,
        metric_calls_used: 0,
        reflection_tokens_used: 0,
        started_at: now,
        completed_at: null,
        failure_reason: null,
        inherited_from: inherited_from
    )
}

rule RecordCompletedModelCall {
    when: OptimizationModelCallCompleted(optimization, call_identifier, role, model_provenance, trace_identifier)
    requires: optimization.status = running
    requires: not exists ModelCallEvidence{optimization: optimization, call_identifier: call_identifier}

    ensures: ModelCallEvidence.created(
        optimization: optimization,
        call_identifier: call_identifier,
        role: role,
        model_provenance: model_provenance,
        trace_identifier: trace_identifier,
        completed_at: now
    )
    ensures:
        if role = "proposer":
            optimization.reflection_tokens_used = optimization.reflection_tokens_used + tokens_of(model_provenance)
}

rule CreateCandidate {
    when: CreateCandidate(optimization, instructions, parents, mutation_reason, source_optimization)
    requires: optimization.status = running

    ensures:
        let candidate = InstructionCandidate.created(
            optimization: optimization,
            status: created,
            instructions: instructions,
            generation: if parents.count = 0: 0 else: maximum_generation(parents) + 1,
            source_optimization: source_optimization,
            evaluation: null,
            subsample_evaluation: null,
            mutation_reason: mutation_reason
        )
        for parent in parents:
            CandidateParent.created(child: candidate, parent: parent)
}

rule EvaluateCandidateFully {
    when: FullCandidateEvaluationCompleted(candidate, evaluation)
    requires: candidate.status = created
    requires: candidate.optimization.status = running
    requires: accounted_metric_expenditure(candidate.optimization, evaluation)
        <= candidate.optimization.configuration.maximum_metric_calls

    ensures: candidate.status = evaluated
    ensures: candidate.evaluation = evaluation
    -- Managed attempts were charged before dispatch; historical aggregate-only
    -- runs retain their recorded expenditure. Publication never charges twice.
    ensures: candidate.optimization.metric_calls_used =
        accounted_metric_expenditure(candidate.optimization, evaluation)
    ensures: UpdateParetoFrontier(candidate: candidate)
}

rule RecordImprovingSubsample {
    when: SubsampleEvaluationCompleted(candidate, evaluation, parent_evaluation)
    requires: candidate.status = created
    requires: score_sum(evaluation) > score_sum(parent_evaluation)

    ensures: candidate.status = subsample_evaluated
    ensures: candidate.subsample_evaluation = evaluation
    ensures: FullEvaluationRequested(candidate: candidate)
}

rule RejectNonImprovingSubsample {
    when: SubsampleEvaluationCompleted(candidate, evaluation, parent_evaluation)
    requires: candidate.status = created
    requires: score_sum(evaluation) <= score_sum(parent_evaluation)

    ensures: candidate.status = rejected
    ensures: candidate.subsample_evaluation = evaluation
}

rule EvaluateSubsampleWinnerFully {
    when: FullCandidateEvaluationCompleted(candidate, evaluation)
    requires: candidate.status = subsample_evaluated
    requires: candidate.optimization.status = running

    ensures: candidate.status = evaluated
    ensures: candidate.evaluation = evaluation
    -- Managed attempts were charged before dispatch; historical aggregate-only
    -- runs retain their recorded expenditure. Publication never charges twice.
    ensures: candidate.optimization.metric_calls_used =
        accounted_metric_expenditure(candidate.optimization, evaluation)
    ensures: UpdateParetoFrontier(candidate: candidate)
}

rule ProposeReflectiveMutation {
    when: MutationRoundRequested(optimization)
    requires: optimization.status = running
    requires: optimization.can_afford_round
    requires: optimization.configuration.maximum_reflection_tokens = null or optimization.reflection_tokens_used < optimization.configuration.maximum_reflection_tokens
    let parent = select_pareto_candidate(optimization.frontier_entries)
    let component = next_round_robin_component(parent)
    let minibatch = training_minibatch(optimization.trainset, optimization.configuration.reflection_minibatch_size)

    ensures: ParentMinibatchEvaluationRequested(
        optimization: optimization,
        parent: parent,
        component: component,
        minibatch: minibatch
    )
}

rule ReflectOnTheParentsMinibatch {
    when: ParentMinibatchEvaluated(optimization, parent, component, minibatch, parent_evaluation)
    requires: optimization.status = running
    requires: not (optimization.configuration.skip_perfect_score and all_perfect(parent_evaluation))

    ensures: ReflectiveMutationRequested(
        optimization: optimization,
        parent: parent,
        component: component,
        minibatch: minibatch,
        parent_evaluation: parent_evaluation,
        examples: build_dataset(minibatch, parent_evaluation)
    )
    @guidance
        -- The proposal is later judged on this minibatch against this
        -- parent_evaluation (StrictMutationAcceptance).
}

rule SkipAParentPerfectOnItsMinibatch {
    when: ParentMinibatchEvaluated(optimization, parent, component, minibatch, parent_evaluation)
    requires: optimization.status = running
    requires: optimization.configuration.skip_perfect_score
    requires: all_perfect(parent_evaluation)

    ensures: MutationRoundSkipped(optimization: optimization, parent: parent, minibatch: minibatch)
    @guidance
        -- No proposer call is made for the round; the skipped comparison is
        -- still recorded so completion is not blocked.
}

rule RecordReflectiveMutation {
    when: ReflectiveMutationProposed(optimization, parent, component, proposal)
    requires: optimization.status = running

    ensures: CreateCandidate(
        optimization: optimization,
        instructions: replace_instruction(parent.instructions, component, proposal.instruction),
        parents: { parent },
        mutation_reason: "reflective_mutation",
        source_optimization: null
    )
}

rule RecordAcceptedMerge {
    when: MergeEvaluated(optimization, first_parent, second_parent, merged_instructions, accepted)
    requires: optimization.status = running
    requires: accepted = true

    ensures: MergeAttempt.created(
        optimization: optimization,
        first_parent: first_parent,
        second_parent: second_parent,
        accepted: true,
        attempted_at: now
    )
    ensures: CreateCandidate(
        optimization: optimization,
        instructions: merged_instructions,
        parents: { first_parent, second_parent },
        mutation_reason: "common_ancestor_crossover",
        source_optimization: null
    )
}

rule RecordRejectedMerge {
    when: MergeEvaluated(optimization, first_parent, second_parent, merged_instructions, accepted)
    requires: optimization.status = running
    requires: accepted = false

    ensures: MergeAttempt.created(
        optimization: optimization,
        first_parent: first_parent,
        second_parent: second_parent,
        accepted: false,
        attempted_at: now
    )
}

rule CompleteOptimization {
    when: OptimizationBudgetExhausted(optimization)
    requires: optimization.status = running
    requires: not optimization.can_afford_round
    requires: admitted_evaluations_finished(optimization)
    requires: publishable_evaluations_recorded(optimization)

    ensures: optimization.completed_at = now
    ensures:
        if fully_evaluated_candidate_exists(optimization):
            optimization.status = completed
            BestCandidateReturned(
                optimization: optimization,
                candidate: best_aggregate_candidate(optimization.candidates)
            )
        else:
            optimization.status = failed
            optimization.failure_reason = "Metric budget exhausted before a complete candidate evaluation"
}

rule CompleteOptimizationAtReflectionBudget {
    when: ReflectionBudgetExhausted(optimization)
    requires: optimization.status = running
    requires: optimization.configuration.maximum_reflection_tokens != null
    requires: optimization.reflection_tokens_used >= optimization.configuration.maximum_reflection_tokens
    requires: admitted_evaluations_finished(optimization)
    requires: publishable_evaluations_recorded(optimization)

    ensures: optimization.completed_at = now
    ensures:
        if fully_evaluated_candidate_exists(optimization):
            optimization.status = completed
            BestCandidateReturned(
                optimization: optimization,
                candidate: best_aggregate_candidate(optimization.candidates)
            )
        else:
            optimization.status = failed
            optimization.failure_reason = "Reflection token budget exhausted before a complete candidate evaluation"
}

rule FailOptimization {
    when: OptimizationCannotContinue(optimization, reason)
    requires: optimization.status = running

    ensures: optimization.status = failed
    ensures: optimization.completed_at = now
    ensures: optimization.failure_reason = reason
}

rule ResumeOptimization {
    when: ResumeOptimization(consumer, optimization)
    requires: optimization.status = running

    ensures: OptimizationFrontierReconstructed(optimization: optimization)
}

rule ApplyOptimizationWinner {
    when: ApplyOptimizationWinner(consumer, optimization, source_version)
    requires: optimization.status = completed
    let winner = best_aggregate_candidate(optimization.candidates)

    ensures: WinnerPublishedAsNewWorkflowVersion(
        optimization: optimization,
        candidate: winner,
        workflow: optimization.workflow,
        source_version: source_version
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant MetricBudgetNotExceeded {
    for optimization in OptimizationRuns:
        optimization.metric_calls_used <= optimization.configuration.maximum_metric_calls
}

invariant CandidateScoresAreBounded {
    for candidate in InstructionCandidates:
        candidate.status = evaluated implies
            candidate.evaluation.scores.all(s => s >= 0 and s <= 1)
}

invariant ParentsRemainInSameLineage {
    for relationship in CandidateParents:
        relationship.child.optimization = relationship.parent.optimization
        or relationship.child.source_optimization = relationship.parent.optimization
}

invariant OneParetoEntryPerValidationExample {
    for a in ParetoEntries:
        for b in ParetoEntries:
            a != b and a.optimization = b.optimization implies
                a.validation_index != b.validation_index
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface PromptOptimization {
    facing consumer: OptimizationConsumer

    provides:
        StartOptimization(consumer, workflow, trainset, validation_set, configuration, inherited_from)
        ResumeOptimization(consumer, optimization)
        ApplyOptimizationWinner(consumer, optimization, source_version)

    exposes:
        OptimizationRun
        InstructionCandidate
        ParetoEntry
        MergeAttempt
        ModelCallEvidence

    contracts:
        demands CandidateMetric
        fulfils ReflectiveInstructionProposer
        fulfils ParetoPopulationSelection
        fulfils DurableOptimizationLifecycle

    @guarantee StaticInstructionsOnly
        -- GEPA changes named static LLM-node instructions; it does not alter
        -- workflow structure, blackboard contracts, or RLM tree design.

    @guarantee CrossRunMining
        -- Completed Pareto candidates and their evaluation evidence remain
        -- queryable as seed material for later runs on the same workflow.
}
